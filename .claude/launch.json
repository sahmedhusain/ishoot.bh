{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "admin",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@platform/admin",
        "dev"
      ],
      "port": 3001
    },
    {
      "name": "admin-verify",
      "runtimeExecutable": "pnpm",
