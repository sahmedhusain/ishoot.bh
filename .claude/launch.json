{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "admin",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@ishoot/admin",
        "dev"
      ],
      "port": 3001
    },
    {
      "name": "admin-verify",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@ishoot/admin",
        "exec",
        "next",
        "dev",
        "--turbopack",
        "-p",
        "3002"
      ],
      "port": 3002
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@ishoot/web",
        "dev"
      ],
      "port": 3000
    }
  ]
}