{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "admin",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@platform/admin",
        "dev"
      ],
      "port": 3001
    },
    {
      "name": "admin-verify",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@platform/admin",
        "exec",
        "next",
        "dev",
        "--turbopack",
        "-p",
        "3002"
      ],
      "port": 3002
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@platform/web",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "admin-demo",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "tests/e2e/serve.cjs",
        "admin",
        "3012",
        "platform_e2e_test"
      ],
      "port": 3012
    },
    {
      "name": "web-demo",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "tests/e2e/serve.cjs",
        "web",
        "3013",
        "platform_e2e_test"
      ],
      "port": 3013
    },
    {
      "name": "admin-setup",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "tests/e2e/serve.cjs",
        "admin",
        "3014",
        "platform_e2e_blank_test"
      ],
      "port": 3014
    },
    {
      "name": "web-setup",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "tests/e2e/serve.cjs",
        "web",
        "3015",
        "platform_e2e_blank_test"
      ],
      "port": 3015
    },
    {
      "name": "admin-v2",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "WEB_URL=http://localhost:3022",
        "NEXT_PUBLIC_WEB_URL=http://localhost:3022",
        "ADMIN_URL=http://localhost:3021",
        "NEXT_PUBLIC_ADMIN_URL=http://localhost:3021",
        "node",
        "tests/e2e/serve.cjs",
        "admin",
        "3021",
        "pv2_seeded_test"
      ],
      "port": 3021
    },
    {
      "name": "web-v2",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "WEB_URL=http://localhost:3022",
        "NEXT_PUBLIC_WEB_URL=http://localhost:3022",
        "ADMIN_URL=http://localhost:3021",
        "NEXT_PUBLIC_ADMIN_URL=http://localhost:3021",
        "node",
        "tests/e2e/serve.cjs",
        "web",
        "3022",
        "pv2_seeded_test"
      ],
      "port": 3022
    },
    {
      "name": "admin-volume",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "tests/e2e/serve.cjs",
        "admin",
        "3023",
        "pv2_volume_test"
      ],
      "port": 3023
    }
  ]
}
