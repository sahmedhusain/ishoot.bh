{
  "name": "@platform/api-client",
  "version": "1.0.0",
  "private": true,
  "description": "Server-side client for the Go backend services, generated from their OpenAPI documents.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../../backend/services/files/api/openapi.yaml -o src/generated/files.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.3"
  }
}
