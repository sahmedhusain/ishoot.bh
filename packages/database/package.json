{
  "name": "@platform/database",
  "version": "1.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./website-config": "./src/website-config.ts",
    "./website-presets": "./src/website-presets.ts",
    "./db": "./src/db.ts",
    "./observability": "./src/observability.ts",
    "./queries/*": "./src/queries/*.ts",
    "./services/*": "./src/services/*.ts",
    "./constants/*": "./src/constants/*.ts",
    "./finance/*": "./src/finance/*.ts",
    "./hr/*": "./src/hr/*.ts",
    "./cms/*": "./src/cms/*.ts",
    "./samples/*": "./src/samples/*.ts"
  },
  "scripts": {
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:check-integrity": "ts-node --project tsconfig.seed.json prisma/check-integrity.ts",
    "type-check": "tsc --noEmit && tsc --project tsconfig.seed.json --noEmit"
  },
  "dependencies": {
    "@platform/locales": "workspace:*",
    "@prisma/client": "5.22.0",
    "@supabase/supabase-js": "^2.117.2",
    "bcryptjs": "^3.0.3",
    "libphonenumber-js": "^1.13.14",
    "@platform/config": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "prisma": "5.22.0",
    "typescript": "^5.7.3"
  }
}
