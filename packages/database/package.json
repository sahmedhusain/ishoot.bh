{
  "name": "@ishoot/database",
  "version": "1.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./config": "./src/initial-company-config.json",
    "./website-config": "./src/website-config.ts",
    "./db": "./src/db.ts",
    "./observability": "./src/observability.ts",
    "./queries/*": "./src/queries/*.ts",
    "./services/*": "./src/services/*.ts"
  },
  "scripts": {
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:seed": "ts-node --project tsconfig.seed.json prisma/seed.ts",
    "type-check": "tsc --noEmit && tsc --project tsconfig.seed.json --noEmit"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@supabase/supabase-js": "^2.117.2",
    "bcryptjs": "^3.0.3",
    "libphonenumber-js": "^1.13.14",
    "@ishoot/config": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "prisma": "5.22.0",
    "typescript": "^5.7.3"
  }
}
