{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@platform/config/currency": ["../config/src/constants/currency.d.cts"],
      "@platform/config/phone": ["../config/src/phone.ts"],
      "@platform/config/constants": ["../config/src/constants/index.ts"],
      "@platform/config": ["../config/tailwind.config.ts"],
      "@platform/config/*": ["../config/src/*"],
      "@platform/locales": ["../locales/src/index.ts"],
      "@platform/locales/*": ["../locales/src/*"]
    }
  },
  "include": ["prisma/check-integrity.ts"]
}
