{
  "name": "@platform/config",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./tailwind.config.ts",
  "types": "./tailwind.config.ts",
  "exports": {
    ".": "./tailwind.config.ts",
    "./constants": "./src/constants/index.ts",
    "./currency": {
      "types": "./src/constants/currency.d.cts",
      "default": "./src/constants/currency.cjs"
    }
  },
  "dependencies": {
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "scripts": {
    "type-check": "tsc --noEmit --module ESNext --moduleResolution Bundler --target ES2022 --resolveJsonModule tailwind.config.ts src/constants/index.ts"
  }
}
