{
  "$schema": "https://v2-11-10.turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        ".next-audit/**",
        "dist/**"
      ],
      "env": [
        "DATABASE_URL",
        "JWT_SECRET",
        "REVALIDATION_SECRET",
        "WEB_URL",
        "ADMIN_URL",
        "RESEND_API_KEY",
        "FROM_EMAIL",
        "NOTIFICATION_EMAIL",
        "NEXT_PUBLIC_WEB_URL",
        "NEXT_PUBLIC_ADMIN_URL",
        "NEXT_PUBLIC_DEFAULT_LOCALE",
        "NEXT_DIST_DIR",
        "UPLOAD_ROOT",
        "MFA_ENCRYPTION_KEY",
        "TRUSTED_CLIENT_IP_HEADER",
        "OBSERVABILITY_ENABLED"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "type-check": {
      "dependsOn": [
        "^build"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalDependencies": [
    ".env"
  ]
}
