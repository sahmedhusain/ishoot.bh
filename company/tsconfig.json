{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@platform/config/currency": [
        "../apps/admin/lib/config/constants/currency.d.cts"
      ],
      "@platform/config/phone": [
        "../apps/admin/lib/config/phone.ts"
      ],
      "@platform/config/constants": [
        "../apps/admin/lib/config/constants/index.ts"
      ],
      "@platform/config": [
        "../apps/admin/lib/config/index.ts"
      ],
      "@platform/config/*": [
        "../apps/admin/lib/config/*"
      ],
      "@platform/locales": [
        "../apps/admin/locales/index.ts"
      ],
      "@platform/locales/*": [
        "../apps/admin/locales/*"
      ],
      "@platform/database": [
        "../apps/admin/lib/database/index.ts"
      ],
      "@platform/database/*": [
        "../apps/admin/lib/database/*"
      ],
      "@platform/api-client": [
        "../apps/admin/lib/api/index.ts"
      ],
      "@platform/api-client/*": [
        "../apps/admin/lib/api/*"
      ]
    }
  },
  "include": [
    "seed/**/*.ts",
    "tools/**/*.ts"
  ]
}
