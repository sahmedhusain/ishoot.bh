{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.cjs",
        "tests/**/*.{ts,cjs}",
        "playwright.config.ts",
        "vitest.config.ts"
      ],
      "project": [
        "scripts/*.cjs",
        "tests/**/*.{ts,cjs}"
      ]
    },
    "apps/*": {
      "entry": [
        "app/**/{page,layout,route,loading,error,not-found}.tsx",
        "app/**/route.ts"
      ],
      "project": [
        "**/*.{ts,tsx,mjs,css}"
      ]
    },
    "company": {
      "entry": [
        "seed/seed.ts",
        "seed/*.cjs",
        "scripts/*.cjs",
        "tools/*.ts"
      ],
      "project": [
        "**/*.{ts,cjs}"
      ]
    }
  },
  "ignoreDependencies": [
    "@prisma/client",
    "@supabase/supabase-js",
    "bcryptjs",
    "eslint-config-next",
    "libphonenumber-js",
    "sharp"
  ],
  "ignoreIssues": {
    "apps/admin/app/actions/mom.ts": [
      "exports"
    ]
  }
}
