{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.cjs", "tests/**/*.{ts,cjs}"],
      "project": ["scripts/*.cjs", "tests/**/*.{ts,cjs}"]
    },
    "apps/*": {
      "entry": [
        "app/**/{page,layout,route,loading,error,not-found}.tsx",
        "app/**/route.ts"
      ],
      "project": ["**/*.{ts,tsx,mjs,css}"]
    },
    "company": {
      "entry": ["seed/*.cjs", "scripts/*.cjs", "tools/*.{ts,cjs}"],
      "project": ["**/*.{ts,cjs}"]
    }
  },
  "ignoreDependencies": [
    "@prisma/client",
    "bcryptjs",
    "libphonenumber-js",
    "sharp"
  ],
  "ignoreIssues": {
    "apps/admin/app/actions/mom.ts": ["exports"],
    "apps/admin/app/actions/assets.ts": ["exports"],
    "apps/admin/app/actions/crm.ts": ["exports"],
    "apps/admin/app/actions/hrms.ts": ["exports"],
    "apps/admin/app/actions/notifications.ts": ["exports"],
    "apps/admin/app/actions/profile.ts": ["exports"],
    "apps/admin/app/actions/quotations.ts": ["exports"],
    "apps/admin/app/actions/requests.ts": ["exports"],
    "apps/admin/app/actions/salary-documents.ts": ["exports"],
    "apps/admin/app/actions/sales.ts": ["exports"],
    "apps/admin/app/actions/users.ts": ["exports"]
  },
  "ignore": [
    "apps/admin/app/actions/commissions.ts",
    "apps/admin/app/actions/packages.ts",
    "apps/admin/app/actions/retail.ts",
    "apps/admin/app/actions/serialized-stock.ts",
    "packages/api-client/src/generated/**"
  ]
}
