!apps/admin/package-lock.json
!apps/it/package-lock.json
!apps/store/package-lock.json
!apps/web/package-lock.json

# ---> Build Outputs & Caches
.next/
.next-*/
**/.next/
**/.next-*/
.turbo/
*/.turbo/
*.tsbuildinfo
dist/
out/
coverage/
*.lcov
*.out

# ---> Testing & E2E Outputs
tests/e2e/.uploads/
playwright-report/
test-results/
.playwright-cli/
**/.results/

# ---> Infrastructure & Local State (Terraform / Vercel)
.vercel/
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
