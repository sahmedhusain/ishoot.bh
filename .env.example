# ==========================================
# Enterprise Monorepo Environment Configuration (Template)
# ==========================================

# ------------------------------------------
# 1. Database Configuration (PostgreSQL 15+)
# ------------------------------------------
POSTGRES_USER="ishoot"
POSTGRES_PASSWORD="CHANGE_TO_STRONG_PASSWORD"
POSTGRES_DB="ishoot_db"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"

# Prisma Primary Connection String (Pooler or Direct)
# For production cloud databases (Neon, Supabase, RDS), append ?sslmode=require
DATABASE_URL="postgresql://ishoot:CHANGE_TO_STRONG_PASSWORD@localhost:5432/ishoot_db?schema=public&connection_limit=5&pool_timeout=10"

# ------------------------------------------
# 2. Initial Super Admin Bootstrap Credentials
# (Used upon initial database provisioning/seeding; hashed into User table)
# ------------------------------------------
SUPER_ADMIN_EMAIL="admin@ishoot.bh"
SUPER_ADMIN_PASSWORD="CHANGE_TO_SECURE_ADMIN_PASSWORD"
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_PHONE="+973 3900 1100"

# ------------------------------------------
# 3. Application URLs & Webhooks
# ------------------------------------------
NODE_ENV="development" # Set to "production" in live environments
WEB_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"

# Public Browser-Accessible URLs (Exposed to Next.js Client Components)
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"
NEXT_PUBLIC_DEFAULT_LOCALE="ar"

# ------------------------------------------
# 4. Security & Cryptographic Keys
# ------------------------------------------
# Secure 256-bit keys (e.g. generated via `openssl rand -base64 32`)
JWT_SECRET="GENERATE_AND_SET_SECURE_JWT_SECRET_KEY_MIN_32_CHARS"
REVALIDATION_SECRET="GENERATE_AND_SET_SECURE_REVALIDATION_SECRET_KEY"

# ------------------------------------------
# 5. Email & Notification Dispatch
# ------------------------------------------
RESEND_API_KEY=""
FROM_EMAIL="ishoot <notifications@ishoot.bh>"
NOTIFICATION_EMAIL="hello@ishoot.bh"

# ------------------------------------------
# 6. Reserved S3 configuration (adapter not implemented; see UPLOAD_ROOT)
# ------------------------------------------
S3_ENDPOINT="https://s3.amazonaws.com"
S3_REGION="eu-central-1"
S3_BUCKET="ishoot-media-assets"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ------------------------------------------
# 7. pgAdmin Management Console (Local Docker Only)
# ------------------------------------------
PGADMIN_DEFAULT_EMAIL="admin@ishoot.bh"
PGADMIN_DEFAULT_PASSWORD="CHANGE_TO_SECURE_PASSWORD"
PGADMIN_PORT="5050"

# Separate 32-byte base64 encryption key for MFA secrets; preserve and back up securely.
MFA_ENCRYPTION_KEY=""
# Required absolute durable shared mount in production. S3 variables above are not wired.
UPLOAD_ROOT=""
# Set only when your trusted ingress overwrites this header and blocks direct access.
TRUSTED_CLIENT_IP_HEADER=""
# Opt-in structured timing/query counters; no query arguments or passwords are logged.
OBSERVABILITY_ENABLED="false"
# Production bootstrap requires an operator-approved company JSON file.
COMPANY_CONFIG_FILE=""
