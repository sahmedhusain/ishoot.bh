# ==================================================================================================
# Business platform: environment configuration
# ==================================================================================================
# Copy to .env (`./run.sh env init` does it and fills in the secrets). All 3 frontend apps (web, admin, it),
# the Go microservices, the scripts and the tests read this one root file. Never commit .env.
#
#   [required]   needed in every environment
#   [production] needed for a live installation (checked by `./run.sh deploy check`)
#   [optional]   has a sensible default, or switches a feature on
#
# Payment gateways, courier agencies, WhatsApp, Google/Apple sign-in and social accounts are NOT set
# here: they are saved, encrypted with ENCRYPTION_KEY, in Admin → Settings → Integrations.

# --------------------------------------------------------------------------------------------------
# 1. Application and addresses
# --------------------------------------------------------------------------------------------------
NODE_ENV="development"                         # "production" in live environments
WEB_URL="http://localhost:3000"                # [required] website, server side (links, revalidation, broadcasts)
ADMIN_URL="http://localhost:3001"              # [required] admin, server side (e-mail links, payment returns)
IT_URL="http://localhost:3002"                 # [required] IT dashboard, server side
NEXT_PUBLIC_WEB_URL="http://localhost:3000"    # [required] website address seen by the browser (admin previews)
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"  # [required] admin address seen by the browser (live preview)
NEXT_PUBLIC_IT_URL="http://localhost:3002"     # [required] IT dashboard address seen by the browser
ADMIN_APP_URL=""  # [optional] address clients open links and QR codes on, if not ADMIN_URL
# Without these, the company's own domains (Settings → Website) are used.

# --------------------------------------------------------------------------------------------------
# 2. Database (PostgreSQL 17)
# --------------------------------------------------------------------------------------------------
# The local stack (`./run.sh services up`) runs Postgres from docker-compose.yml. `./run.sh env secrets` fills
# POSTGRES_PASSWORD and, when they are empty, DATABASE_URL and DIRECT_URL pointing at it.
POSTGRES_USER="platform"
POSTGRES_PASSWORD=""                           # [required] generated by env secrets
# Each backend service signs in as its own login (svc_<service>), which owns its schema and nothing else.
FILES_DB_PASSWORD=""                           # [required] generated by env secrets; changing it and restarting rotates it
IDENTITY_DB_PASSWORD=""                        # [required] generated by env secrets
SYSTEM_DB_PASSWORD=""                          # [required] generated by env secrets
ITSM_DB_PASSWORD=""                            # [required] generated by env secrets
AUDIT_DB_PASSWORD=""                           # [required] generated by env secrets
NOTIFY_DB_PASSWORD=""                          # [required] generated by env secrets
REALTIME_DB_PASSWORD=""                        # [required] generated by env secrets
CMS_DB_PASSWORD=""                             # [required] generated by env secrets
COMMERCE_DB_PASSWORD=""                        # [required] generated by env secrets
DELIVERY_DB_PASSWORD=""                        # [required] generated by env secrets
FINANCE_DB_PASSWORD=""                         # [required] generated by env secrets
HR_DB_PASSWORD=""                              # [required] generated by env secrets
INVENTORY_DB_PASSWORD=""                       # [required] generated by env secrets
SALES_DB_PASSWORD=""                           # [required] generated by env secrets
WORKFLOW_DB_PASSWORD=""                        # [required] generated by env secrets
PGBOUNCER_PORT="6432"                          # connection pooler in front of Postgres (the services' request paths)
DB_ROLE_STATEMENT_TIMEOUT=""  # default statement limit of the services' logins
POSTGRES_DB="platform_db"
POSTGRES_PORT="5432"
DATABASE_URL=""                                # [required] used by the apps (generated for the local stack)
DATABASE_DIRECT_URL=""                         # [required] direct connection, used by migrations
# Production: the pooler for DATABASE_URL (with a pool size, a timeout and TLS) and a direct URL, for example
# DATABASE_URL: "postgresql://app:<password>@pooler.internal:6432/platform?pgbouncer=true&connection_limit=5&pool_timeout=20&sslmode=require"
# DATABASE_DIRECT_URL: "postgresql://app:<password>@db.internal:5432/platform?sslmode=require"
PGADMIN_DEFAULT_EMAIL="admin@example.com"
PGADMIN_DEFAULT_PASSWORD=""                    # generated by env secrets (pgAdmin: docker compose --profile tools up -d)
PGADMIN_PORT="5050"

# --------------------------------------------------------------------------------------------------
# 3. Backend services and file storage (docs/backend)
# --------------------------------------------------------------------------------------------------
# The apps reach the Go services through the gateway, signing each call with their own service key
# (docs/adr/0011). Files are kept by the files service in S3-compatible storage (SeaweedFS locally).
API_URL="http://127.0.0.1:8080"                # [required] the backend gateway, seen from the apps' servers
ADMIN_SERVICE_KEY=""                           # [required] generated by env secrets; never share it
WEB_SERVICE_KEY=""                             # [required] generated by env secrets; never share it
IT_SERVICE_KEY=""                              # [required for IT login] generated by env secrets; never share it
SYSTEM_SERVICE_KEY=""                          # company artwork metadata reads; generated by env secrets
IDENTITY_SERVICE_KEY=""                        # [required for staff access policy] identity's module-read key; env secrets
IDENTITY_SYSTEM_URL=""  # system API used by identity for current module availability
ADMIN_SERVICE_KEY_PREVIOUS=""  # [optional] during a key rotation, the old key stays trusted
WEB_SERVICE_KEY_PREVIOUS=""
IT_SERVICE_KEY_PREVIOUS=""
IDENTITY_SERVICE_KEY_PREVIOUS=""
SERVICE_KEYS_FILE="./.local/service-keys.json" # public keys the services trust; written by env secrets
S3_ACCESS_KEY_ID=""                            # [required] local SeaweedFS credentials, generated by env secrets
S3_SECRET_ACCESS_KEY=""
S3_PORT="8333"
S3_ENDPOINT="http://127.0.0.1:8333"            # [required] S3-compatible storage endpoint
FILES_ADMIN_PORT="9081"                        # files service probes and metrics (never expose publicly)
ITSM_ADMIN_PORT="9083"                         # itsm service probes and metrics (never expose publicly)
SYSTEM_ADMIN_PORT="9084"                       # system service probes and metrics (never expose publicly)
AUDIT_ADMIN_PORT="9085"                        # audit service probes and metrics (never expose publicly)
NOTIFY_ADMIN_PORT="9086"                       # notify service probes and metrics (never expose publicly)
NOTIFY_SERVICE_KEY=""                          # [required] notify's own service key (reads integration credentials from system); env secrets
DELIVERY_SERVICE_KEY=""                        # [required] delivery's key for requesting proof-photo deletion; env secrets
REALTIME_ADMIN_PORT="9087"                     # realtime service probes and metrics (never expose publicly)
NOTIFICATION_HANDOVER_MS=""  # how often the admin hands new notifications to notify (0 turns it off)
WHATSAPP_SANDBOX_PORT="8095"                   # local WhatsApp stand-in: http://localhost:8095 lists what was sent
NOTIFY_EMAIL_PROVIDER=""  # smtp (Mailpit locally) or integration (Resend, as IT set it up)
NOTIFY_WHATSAPP_URL=""  # the sandbox locally; https://graph.facebook.com/v21.0 for real
NOTIFY_WHATSAPP_CREDENTIALS=""  # static (sandbox) or integration (IT dashboard → Integrations → WhatsApp)
SYSTEM_MODULES_CACHE_MS=""  # how long the apps reuse the module list they read
SYSTEM_MODULE_READ_CALLERS="identity"          # additional callers that may read modules, without integration credentials
SYSTEM_INTEGRATION_WRITERS=""  # service callers allowed to change integration settings
SYSTEM_DOMAIN_WRITERS=""  # service callers allowed to set the domains (the setup wizard)
SYSTEM_SITE_CODE_BODY_LIMIT=""  # largest site code request the system service accepts, in bytes
SYSTEM_SITE_CACHE_MS=""  # how long the apps reuse the domains and site code they read
NATS_PORT="4222"                               # events broker (NATS JetStream); services publish their outbox to it
NATS_MONITOR_PORT="8222"                       # NATS monitoring (streams, consumers, lag); never expose publicly
NATS_URL=""  # the broker, as the services see it inside Compose
OUTBOX_INTERVAL=""  # how often a service's relay looks for unpublished events
OUTBOX_RETENTION=""  # how long published events stay in each outbox
MAILPIT_SMTP_PORT="1025"                       # local mail catcher: SMTP for the apps in development
MAILPIT_UI_PORT="8025"                         # read every e-mail sent locally at http://localhost:8025
SECRETS_PRIMARY_KEY_ID=""  # active key in SECRETS_KEYS
SECRETS_KEYS=""  # base64url-encoded 32-byte AES-256 keys
SECRETS_LEGACY_INTEGRATION_KEY=""  # opens credentials written under the previous ENCRYPTION_KEY

# --------------------------------------------------------------------------------------------------
# 4. Company profile and first administrator
# --------------------------------------------------------------------------------------------------
# Profile installed by db:seed, db:reset and db:bootstrap (pure SQL seeds in seeds/sql/).
# Options: "ishoot" (default pure SQL) or "demo" / "northwind". Leave empty in production to set the company up in the setup wizard.
COMPANY_PROFILE="ishoot"
SEED_PRESET=""  # all, products, services, commerce, food, agency (preset in seeds/sql/presets/)

SUPER_ADMIN_EMAIL="admin@example.com"          # [required for bootstrap]
SUPER_ADMIN_PASSWORD=""                        # [required for bootstrap] 12 to 72 bytes; every demo account uses it too
SUPER_ADMIN_NAME="Super Admin"

# --------------------------------------------------------------------------------------------------
# 5. Secrets and keys (`./run.sh env secrets` generates any that are empty)
# --------------------------------------------------------------------------------------------------
REVALIDATION_SECRET=""     # [required] shared by admin, IT dashboard, website and worker to refresh the website
MFA_ENCRYPTION_KEY=""      # [required] exactly 32 random bytes, base64 (openssl rand -base64 32). Keep it stable: changing it invalidates every authenticator app
ERASURE_HASH_KEY=""        # [required] at least 32 characters (openssl rand -hex 16). Keys e-mail hashes in erasure events
ENCRYPTION_KEY=""          # [required] exactly 32 UTF-8 characters (openssl rand -hex 16). Encrypts saved integration credentials (gateways, couriers, WhatsApp…). Keep it stable
CUSTOMER_AUTH_SECRET=""    # [optional] website customer accounts: Google/Apple sign-in state and payment links; falls back to REVALIDATION_SECRET
CRON_SECRET=""             # [production] "Authorization: Bearer <CRON_SECRET>" for the admin's /api/cron:
                           #            e-mail and website queues, overdue invoices, reminders, recurring
                           #            expenses, online payment expiry, courier tracking, task and legal
                           #            reminders, marketing broadcasts and scheduled reports

# --------------------------------------------------------------------------------------------------
# 6. E-mail (Resend)
# --------------------------------------------------------------------------------------------------
# The notify service sends every e-mail: through the Resend integration IT sets up (IT dashboard → Integrations), or
# Mailpit locally (NOTIFY_EMAIL_PROVIDER).
NOTIFICATION_EMAIL="hello@example.com"            # [optional] receives website enquiries (default: the company e-mail). A Resend test account only delivers to its own address
RESEND_WEBHOOK_SECRET=""                           # [production] signing secret of the webhook to <ADMIN_URL>/api/webhooks/resend

# --------------------------------------------------------------------------------------------------
# 7. Exchange rates
# --------------------------------------------------------------------------------------------------
# Live rates with BHD as base. Any provider answering { "rates": { "USD": n, ... } } for base BHD works.

# --------------------------------------------------------------------------------------------------
# 8. Operations
# --------------------------------------------------------------------------------------------------
OBSERVABILITY_ENABLED="false"                  # "true" logs timing and query counts per operation
TRUSTED_CLIENT_IP_HEADER="x-forwarded-for"     # header your proxy overwrites with the client IP (rate limits, audit)
WORKER_ALERT_AFTER_SECONDS=""  # flags queues older than this (minimum 60)
PORT=""  # set by the host; the apps default to 3000 (web) and 3001 (admin)

# --------------------------------------------------------------------------------------------------
# Backend (Go services, docker-compose.yml; see docs/backend/OPERATIONS.md)
# --------------------------------------------------------------------------------------------------
# Every service reads its own variables (generated list: docs/backend/CONFIG.md). These feed the local stack.
APP_ENV="development"                          # development | test | staging | production
LOG_LEVEL="debug"                              # debug | info | warn | error (changeable at runtime per service)
VALKEY_PASSWORD=""                             # [required] local Valkey (cache, rate limits); generated by env init
VALKEY_PORT="6379"
REDIS_URL=""                                   # [required] Valkey for realtime service (derived from VALKEY_PASSWORD and VALKEY_PORT)
GATEWAY_PORT="8080"                            # public API entry point
GATEWAY_ADMIN_PORT="9080"                      # gateway probes and metrics (never expose publicly)
GATEWAY_UPSTREAMS=""                           # name=url pairs the route table refers to, e.g. identity=http://identity:8080
# Required when gateway routes accept staff, customer, or IT tokens.
GATEWAY_IDENTITY_STATUS_URL=""                 # Compose uses identity's /v1/identity/session when empty
GATEWAY_IDENTITY_STATUS_TIMEOUT=3s
GATEWAY_CORS_ORIGINS=""                        # browsers never call the gateway directly; leave empty
GATEWAY_TRUSTED_PROXIES=""                     # CIDRs of the load balancer in front of the gateway
AUTH_ISSUER=""                                 # identity issuer URL; Compose uses http://identity:8080 when empty
AUTH_JWKS_URL=""                               # identity JWKS URL; Compose uses identity's /.well-known/jwks.json when empty
# Observability profile (`docker compose --profile observability up -d`)
OTEL_EXPORTER_OTLP_ENDPOINT=""                 # e.g. http://otel-collector:4318 to export traces
GRAFANA_ADMIN_PASSWORD=""                      # generated by env init
GRAFANA_PORT="3300"
PROMETHEUS_PORT="9091"
ADMIN_ENABLE_PPROF="false"                     # Go profiling on the internal admin port (development only)

# --------------------------------------------------------------------------------------------------
# 9. Local sandboxes (development and tests only; leave unset in production)
# --------------------------------------------------------------------------------------------------
# Point a payment gateway or courier API at a local stand-in instead of its real host:
PAYMENT_GATEWAY_BASE_URL_STRIPE=""
PAYMENT_GATEWAY_BASE_URL_TAP=""
PAYMENT_GATEWAY_BASE_URL_PAYPAL=""
PAYMENT_GATEWAY_BASE_URL_CHECKOUT_COM=""
PAYMENT_GATEWAY_BASE_URL_PAYTABS=""
PAYMENT_GATEWAY_BASE_URL_MOYASAR=""
PAYMENT_GATEWAY_BASE_URL_HYPERPAY=""
COURIER_BASE_URL_ARAMEX=""
COURIER_BASE_URL_DHL_EXPRESS=""
COURIER_BASE_URL_SMSA=""

# --------------------------------------------------------------------------------------------------
# 10. Tests (every test database name must end in _test; see docs/TESTING.md)
# --------------------------------------------------------------------------------------------------
E2E_SEEDED_DATABASE=""  # admin and website journeys
E2E_BLANK_DATABASE=""  # setup wizard
E2E_SERVER_MODE=""  # "start" serves production builds (built with NEXT_DIST_DIR=.next-e2e)
CHECKS_BARE_DATABASE_URL=""
CHECKS_SEEDED_DATABASE_URL=""

# Optional additional admin origins allowed to frame the website for previews (comma-separated).
ADMIN_PREVIEW_ORIGINS=""

# Identity service (staff and IT sign-in; customer app cutover follows)
IDENTITY_ISSUER="http://identity:8080"
IDENTITY_JWKS_URL="http://127.0.0.1:8082/.well-known/jwks.json" # admin server reads identity public keys
IDENTITY_CALLERS_STAFF="admin,it" # setup uses the admin caller; IT manages staff accounts
IDENTITY_CALLERS_CUSTOMER="web"
IDENTITY_CALLERS_IT="it,admin"
IDENTITY_LOGIN_PASSWORD_MIN_LENGTH="12"
IDENTITY_LOGIN_PASSWORD_RESET_TTL="15m"
IDENTITY_LOGIN_CUSTOMER_WEB_URL="http://localhost:3000" # OAuth callback origin until the company domain is configured
IDENTITY_SIGNING_JWK="" # generated by env secrets; private key, keep secret
IDENTITY_PORT="8082"
IDENTITY_ADMIN_PORT="9082"
IDENTITY_LOGIN_ENABLED="true" # staff and IT sign in through identity
IDENTITY_LOGIN_REDIS_URL="" # Compose derives its private Valkey URL when empty
# Durable identity-to-business profile deliveries; use host-reachable app URLs for Compose workers.
IDENTITY_PROJECTION_ADMIN_URL="http://host.docker.internal:3001"
IDENTITY_PROJECTION_WEB_URL="http://host.docker.internal:3000"
IDENTITY_PROJECTION_INTERVAL="5s"
IDENTITY_LOGIN_RATE_KEY="" # generated by env secrets
IDENTITY_LOGIN_MFA_KEYS="" # key ID and base64 key ring; generated by env secrets
IDENTITY_LOGIN_MFA_PRIMARY_ID="primary"
IDENTITY_LOGIN_MFA_LEGACY_KEY="" # copied from MFA_ENCRYPTION_KEY when blank; preserve for existing users
IDENTITY_LOGIN_IT_ALLOWED_CIDRS=""
IDENTITY_LOGIN_MFA_ISSUER=""  # name of the entry in authenticator apps

# IT dashboard (apps/it, port 3002). It calls the gateway (API_URL) with IT_SERVICE_KEY and the person's own token,
# and refreshes the website (WEB_URL, REVALIDATION_SECRET) after a domain change.
IT_IDENTITY_JWKS_URL="http://127.0.0.1:8082/.well-known/jwks.json" # identity's public keys, read server-side
IT_DEFAULT_LOCALE=""  # ar or en, until the person chooses
IT_CLIENT_IP_HEADER=""  # header the trusted ingress sets with the client address
IT_REFRESH_LEEWAY_SECONDS=""  # renew the access token this long before it expires
