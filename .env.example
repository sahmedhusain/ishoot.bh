# ==========================================
# Business platform monorepo environment configuration
# ==========================================

# ------------------------------------------
# 1. Database Configuration (Supabase Postgres)
# ------------------------------------------
# For local testing via 'npx supabase start', use the default local credentials:
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# For production, you MUST use the connection pooler (e.g. port 6543) for DATABASE_URL
# DATABASE_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------
# 2. Storage & Auth Configuration (Supabase)
# ------------------------------------------
# Local testing defaults (from npx supabase start)
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="" # Set locally; never commit real credentials
SUPABASE_SERVICE_ROLE_KEY="" # Set locally; never commit real credentials

# ------------------------------------------
# 3. Initial Super Admin Bootstrap Credentials
# ------------------------------------------
# Company profile installed by `pnpm db:seed` and `pnpm db:bootstrap` (company/profiles/<name>).
# Leave empty in production to configure the company through the first-run setup wizard.
COMPANY_PROFILE="demo"

SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="" # Set locally; never commit real credentials
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_PHONE="+973 3900 1100"

# ------------------------------------------
# 4. Application URLs
# ------------------------------------------
NODE_ENV="development" # Set to "production" in live environments
WEB_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"
NEXT_PUBLIC_DEFAULT_LOCALE="ar"

# ------------------------------------------
# 5. Security & Cryptographic Keys
# ------------------------------------------
# Must be generated securely (e.g. openssl rand -base64 32)
JWT_SECRET="" # Set locally; never commit real credentials
REVALIDATION_SECRET="" # Set locally; never commit real credentials
MFA_ENCRYPTION_KEY="" # Set locally; never commit real credentials

# ------------------------------------------
# 6. Email & Notifications (Resend)
# ------------------------------------------
# Put your free Resend API key here for testing
RESEND_API_KEY=""
FROM_EMAIL="Company <notifications@example.com>"
# During testing, this MUST be the exact email you signed up to Resend with!
NOTIFICATION_EMAIL="hello@example.com"

# ------------------------------------------
# 7. Integrations (Encrypted at rest)
# ------------------------------------------
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_ID=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# ------------------------------------------
# 8. Logging & Telemetry
# ------------------------------------------
OBSERVABILITY_ENABLED="false"
TRUSTED_CLIENT_IP_HEADER="x-forwarded-for"

# Server-side storage URL (same project as NEXT_PUBLIC_SUPABASE_URL)
SUPABASE_URL="http://127.0.0.1:54321"
CRON_SECRET=""
RESEND_WEBHOOK_SECRET="" # Signing secret from the Resend webhook settings

ENCRYPTION_KEY="" # Separate 32-byte UTF-8 key for integration credentials

# Live exchange rates (BHD base). Defaults to https://open.er-api.com/v6/latest/BHD; any provider
# returning { "rates": { "USD": n, ... } } for base BHD works. Set FX_LIVE_DISABLED=1 to use stored/pegged rates only.
# FX_API_URL=""
# FX_LIVE_DISABLED=""
