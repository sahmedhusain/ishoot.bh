# ==========================================
# iShoot Monorepo Environment Configuration (Template)
# ==========================================

# ------------------------------------------
# 1. Database Configuration (PostgreSQL)
# ------------------------------------------
POSTGRES_USER="ishoot"
POSTGRES_PASSWORD="ishoot_password"
POSTGRES_DB="ishoot_db"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"

# Prisma & Application Connection String
DATABASE_URL="postgresql://ishoot:ishoot_password@localhost:5432/ishoot_db?schema=public"

# ------------------------------------------
# 2. pgAdmin Management Console
# ------------------------------------------
# Access URL: http://localhost:5050
PGADMIN_DEFAULT_EMAIL="admin@ishoot.bh"
PGADMIN_DEFAULT_PASSWORD="admin"
PGADMIN_PORT="5050"

# pgAdmin "Add New Server" Connection Details:
# Host name/address : db (when connecting from inside Docker network) or localhost
# Port              : 5432
# Maintenance DB    : ishoot_db
# Username          : ishoot
# Password          : ishoot_password

# ------------------------------------------
# 3. Application URLs & Webhooks
# ------------------------------------------
NODE_ENV="development"
WEB_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"

# ------------------------------------------
# 4. Security & Authentication
# ------------------------------------------
JWT_SECRET="super-secret-jwt-key-change-in-production-2026"
REVALIDATION_SECRET="ishoot-revalidate-secret-2026"

# ------------------------------------------
# 5. Email & Notifications (Optional)
# ------------------------------------------
RESEND_API_KEY="re_123456789_example_key"
FROM_EMAIL="info@ishoot.bh"

# ------------------------------------------
# 6. S3 / Cloud Storage (Optional)
# ------------------------------------------
S3_ENDPOINT="https://s3.amazonaws.com"
S3_BUCKET="ishoot-media-assets"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
