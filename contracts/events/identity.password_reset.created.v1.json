{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.local/events/identity.password_reset.created.v1.json",
  "title": "identity.password_reset.created",
  "description": "Authentication lifecycle metadata only; no address, code or token.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subjectId",
    "realm",
    "changedBy"
  ],
  "properties": {
    "subjectId": {
      "type": "string",
      "minLength": 1
    },
    "realm": {
      "type": "string",
      "enum": [
        "staff",
        "customer"
      ]
    },
    "changedBy": {
      "type": "string",
      "minLength": 1
    }
  }
}
