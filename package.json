{
  "name": "business-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "clean": "node scripts/clean-builds.cjs",
    "kill-ports": "node scripts/kill-ports.cjs",
    "dev": "npm run kill-ports && turbo run dev",
    "dev:web": "npm run kill-ports && turbo run dev --filter=@platform/web",
    "dev:admin": "npm run kill-ports && turbo run dev --filter=@platform/admin",
    "build": "turbo run build --concurrency=1",
    "build:clean": "npm run clean && turbo run build --concurrency=1",
    "db:push": "prisma db push --schema=packages/database/prisma/schema.prisma",
    "db:seed": "pnpm --filter @platform/company seed",
    "db:check-integrity": "pnpm --filter @platform/database db:check-integrity",
    "lint": "eslint apps/admin apps/web packages --max-warnings=0",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "test:platform": "node scripts/check-platform.cjs",
    "test:copy": "node scripts/check-i18n.cjs && node scripts/check-copy.cjs && node scripts/check-message-format.cjs",
    "db:bootstrap": "node scripts/bootstrap-database.cjs",
    "test:audit-db": "node scripts/check-audit-db.cjs",
    "test:audit-security": "node scripts/check-audit-security.cjs",
    "audit:inventory": "node scripts/inventory-platform.cjs",
    "test:followup-db": "node scripts/check-followup-db.cjs",
    "test:followup-http": "node scripts/check-followup-http.cjs",
    "worker:revalidation": "node scripts/revalidation-worker.cjs",
    "worker:email": "node scripts/email-worker.cjs",
    "test:action-schemas": "node scripts/generate-action-schemas.cjs --check",
    "test:open-items-db": "node scripts/check-open-items-db.cjs",
    "check:deployment": "node scripts/check-deployment-config.cjs",
    "check:workers": "node scripts/check-workers.cjs",
    "worker:maintenance": "node scripts/maintenance-worker.cjs",
    "audit:customer-identities": "node scripts/check-customer-identities.cjs",
    "audit:unused": "knip",
    "test:uploads": "node scripts/check-upload-storage.cjs",
    "test:dashboard": "node scripts/check-admin-dashboard.cjs",
    "test:hrms": "node scripts/check-hrms.cjs && node scripts/check-hrms-pdf.cjs",
    "test:hrms-db": "node scripts/check-hrms-db.cjs",
    "test:approvals": "node scripts/check-approvals.cjs",
    "test:approvals-db": "node scripts/check-approvals-db.cjs",
    "test:finance-db": "node scripts/check-finance-db.cjs",
    "test:fx-db": "node scripts/check-fx-db.cjs",
    "test:claims-db": "node scripts/check-claims-db.cjs",
    "test:sales-db": "node scripts/check-sales-db.cjs",
    "test:support-db": "node scripts/check-support-db.cjs",
    "test:signature-db": "node scripts/check-signature-db.cjs",
    "test:signing-db": "node scripts/check-signing-db.cjs",
    "test:stats-db": "node scripts/check-stats-db.cjs",
    "test:dashboard-db": "node scripts/check-dashboard-db.cjs",
    "company:demo-assets": "pnpm --filter @platform/company assets:demo"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.27",
    "knip": "^6.39.0",
    "prettier": "^3.5.1",
    "prisma": "^5.22.0",
    "svix": "^2.6.1",
    "ts-node": "^10.9.2",
    "turbo": "^2.11.7",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "dotenv": "^18.0.4"
  }
}
