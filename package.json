{
  "name": "ishoot-ecosystem",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "clean": "rimraf .next apps/*/.next apps/*/.next/export",
    "kill-ports": "npx kill-port 3000 && npx kill-port 3001 && npx kill-port 3002 && npx kill-port 3003",
    "dev": "npm run kill-ports && turbo run dev --parallel",
    "dev:web": "PORT=3002 turbo run dev --filter=@ishoot/web",
    "dev:admin": "PORT=3003 turbo run dev --filter=@ishoot/admin",
    "build": "npm run clean && turbo run build --concurrency=1",
    "db:push": "prisma db push --schema=packages/database/prisma/schema.prisma",
    "db:seed": "ts-node packages/database/prisma/seed.ts",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "test:platform": "node scripts/check-platform.cjs"
  },
  "devDependencies": {
    "prettier": "^3.5.1",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "*"
    ]
  },
  "dependencies": {
    "dotenv": "^18.0.4"
  }
}
