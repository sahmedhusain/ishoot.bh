{
  "name": "ishoot-ecosystem",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=@ishoot/web",
    "dev:admin": "turbo run dev --filter=@ishoot/admin",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "prettier": "^3.5.1",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  }
}
