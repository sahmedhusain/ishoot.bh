{
  "name": "business-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-service business platform with Go microservices backend and independent Next.js frontend applications.",
  "scripts": {
    "dev:admin": "npm --prefix apps/admin run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:it": "npm --prefix apps/it run dev",
    "build:admin": "npm --prefix apps/admin run build",
    "build:web": "npm --prefix apps/web run build",
    "build:it": "npm --prefix apps/it run build",
    "test:admin": "npm --prefix apps/admin test",
    "test:web": "npm --prefix apps/web test",
    "test:it": "npm --prefix apps/it test",
    "test:admin:e2e": "npm --prefix apps/admin run test:e2e",
    "test:web:e2e": "npm --prefix apps/web run test:e2e",
    "test:it:e2e": "npm --prefix apps/it run test:e2e"
  }
}