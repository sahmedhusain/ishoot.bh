{
  "statuses": [
    "new",
    "triaged",
    "assigned",
    "in_progress",
    "waiting_on_requester",
    "resolved",
    "closed",
    "cancelled"
  ],
  "openStatuses": [
    "new",
    "triaged",
    "assigned",
    "in_progress",
    "waiting_on_requester"
  ],
  "transitions": {
    "triage": { "from": ["new"], "to": "triaged" },
    "assign": {
      "from": [
        "new",
        "triaged",
        "assigned",
        "in_progress",
        "waiting_on_requester"
      ],
      "to": "assigned"
    },
    "start": { "from": ["assigned"], "to": "in_progress" },
    "request_info": {
      "from": ["triaged", "assigned", "in_progress"],
      "to": "waiting_on_requester"
    },
    "provide_info": { "from": ["waiting_on_requester"], "to": "in_progress" },
    "resolve": {
      "from": ["triaged", "assigned", "in_progress", "waiting_on_requester"],
      "to": "resolved"
    },
    "reopen": { "from": ["resolved"], "to": "assigned" },
    "close": { "from": ["resolved"], "to": "closed" },
    "cancel": {
      "from": [
        "new",
        "triaged",
        "assigned",
        "in_progress",
        "waiting_on_requester"
      ],
      "to": "cancelled"
    }
  },
  "requesterTransitions": ["provide_info", "reopen", "close", "cancel"],
  "priorities": ["critical", "high", "normal", "low"],
  "defaultPriority": "normal",
