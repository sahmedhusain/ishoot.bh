datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  branchGrants BranchGrant[]
  id                        String            @id @default(uuid())
  email                     String            @unique
  fullName                  String
  passwordHash              String
  role                      String            @default("viewer") // "super_admin", "admin", "finance_manager", "production_manager", "producer", "editor", "accountant", "viewer"
  roleDefinition            Role              @relation(fields: [role], references: [id], onDelete: Restrict)
  permissions               Json? // custom granular override
  avatarUrl                 String?
  signatureUrl              String?
  phone                     String?
  department                String? // legacy free-text team name; departmentId is the company's department
  departmentId              String?
  departmentRecord          Department?       @relation("UserDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  managerId                 String?
  manager                   User?             @relation("UserHierarchy", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates              User[]            @relation("UserHierarchy")
  isActive                  Boolean           @default(true)
  lastLoginAt               DateTime?
  mfaEnabled                Boolean           @default(false)
  mfaSecretEncrypted        String?
  mfaPendingSecretEncrypted String?
  mfaPendingExpiresAt       DateTime?
  mfaLastStep               BigInt?
  recoveryCodes             MfaRecoveryCode[]
  resetToken                String?
  resetExpiresAt            DateTime?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  assignedDeals                 CrmDeal[]
  assignedInquiries             Inquiry[]
  inquiryNotes                  InquiryNote[]
  invoicesCreated               Invoice[]
  paymentsCreated               Payment[]
  expensesCreated               Expense[]
  calendarEvents                CalendarEvent[]
  activities                    ActivityLog[]
  notifications                 Notification[]
  attachments                   Attachment[]
  sessions                      Session[]
  contractsCreated              Contract[]
  generatedDocuments            GeneratedDocument[]
  companyDocuments              CompanyDocument[]
  emailJobs                     EmailJob[]
  momsCreated                   MinuteOfMeeting[]        @relation("MomCreator")
  momsApproved                  MinuteOfMeeting[]        @relation("MomApprover")
  expenseClaims                 ExpenseClaim[]           @relation("ExpenseClaimClaimant")
  expenseClaimsScheduled        ExpenseClaim[]           @relation("ExpenseClaimScheduler")
  expenseClaimsPaid             ExpenseClaim[]           @relation("ExpenseClaimPayer")
  /// Largest discount (% of subtotal) this user may give without approval; null uses the company default.
  discountLimitPercent          Decimal?                 @db.Decimal(5, 2)
  /// Commission on collected revenue (% of net) credited to this person; null = no commission.
  commissionRatePercent         Decimal?                 @db.Decimal(5, 2)
  quotationsOwned               Quotation[]              @relation("QuotationSalesOwner")
  invoicesOwned                 Invoice[]                @relation("InvoiceSalesOwner")
  attributionChangesFrom        SalesAttributionChange[] @relation("AttributionFrom")
  attributionChangesTo          SalesAttributionChange[] @relation("AttributionTo")
  attributionChangesMade        SalesAttributionChange[] @relation("AttributionChangedBy")
  commissionPayouts             CommissionPayout[]       @relation("CommissionPayee")
  commissionPayoutsRecorded     CommissionPayout[]       @relation("CommissionRecorder")
  supportReimbursementsRecorded SupportReimbursement[]   @relation("SupportReimbursementRecorder")
  signatureChanges              SignatureChange[]        @relation("SignatureChangeOwner")
  signatureChangesReviewed      SignatureChange[]        @relation("SignatureChangeReviewer")
  quotationsSigned              Quotation[]              @relation("QuotationSigner")
  invoicesSigned                Invoice[]                @relation("InvoiceSigner")
  receiptsSigned                Payment[]                @relation("ReceiptSigner")
  authChallenges                AuthChallenge[]
  quotations                    Quotation[]              @relation("QuotationCreator")
  communicationThreads          CommunicationThread[]
  archivedAt                    DateTime?
  archivedById                  String?
  suspendedAt                   DateTime?
  suspendedById                 String?
  suspensionReason              String?

  profileChangesRequested    ProfileChangeRequest[] @relation("ProfileChangeRequester")
  profileChangesManaged      ProfileChangeRequest[] @relation("ProfileChangeManager")
  profileChangesForUser      ProfileChangeRequest[] @relation("UserProfileChanges")
  approvalRequestsCreated    ApprovalRequest[]      @relation("ApprovalRequester")
  approvalDecisionsGiven     ApprovalDecision[]     @relation("ApprovalDecider")
  requestAssignmentsReceived RequestAssignment[]    @relation("RequestAssignee")
  requestAssignmentsGiven    RequestAssignment[]    @relation("RequestAssigner")
  requestCommentsAuthored    RequestComment[]       @relation("RequestCommentAuthor")
  requestEventsAuthored      RequestEvent[]         @relation("RequestEventActor")
  employee                   Employee?              @relation("UserEmployee")
  socialPlansAssigned        SocialContentPlan[]    @relation("SocialPlanAssignee")
  socialPlansCreated         SocialContentPlan[]    @relation("SocialPlanCreator")
  accountChanges             AccountChangeRequest[] @relation("AccountChangeTarget")
  accountChangesFiled        AccountChangeRequest[] @relation("AccountChangeRequester")
  clientSignaturesCreated    ClientSignature[]      @relation("ClientSignatureCreator")
  calendarFeed               CalendarFeedToken?
  announcementReceipts       AnnouncementReceipt[]
  cmsArticles                CmsArticle[]           @relation("CmsArticleAuthor")
  dashboardLayout            DashboardLayout?
  cashierSessions            CashierSession[]       @relation("UserCashierSessions")
  openedShifts               RetailShift[]          @relation("UserOpenedShifts")
  closedShifts               RetailShift[]          @relation("UserClosedShifts")
  retailClosings             RetailClosing[]        @relation("UserRetailClosings")
  paymentCollections         PaymentCollection[]    @relation("UserPaymentCollections")
  attributedCommissions      CommissionSnapshot[]   @relation("UserAttributedCommissions")

  @@index([role])
  @@index([departmentId])
  @@index([fullName])
  @@index([isActive, archivedAt])
}

model CompanySetting {
  id                String  @id @default(uuid())
  singleton         Int     @unique @default(1)
  companyNameEn     String
  companyNameAr     String
  crNumber          String?
  vatId             String?
  vatEnabled        Boolean @default(false)
  vatPercentage     Decimal @default(10.00) @db.Decimal(5, 2)
  vatCertificateUrl String?
  defaultCurrency   String  @default("BHD")
  currencyDecimals  Int     @default(3)
  addressEn         String?
  addressAr         String?
  phone             String?
  whatsappPhone     String?
  email             String?
  website           String?
  instagramUrl      String?
  linkedinUrl       String?
  youtubeUrl        String?
  bankName          String?
  bankIban          String?
  bankAccountNumber String?
  bankSwift         String?
  timeZone          String? @default("Asia/Bahrain")
  logoUrl           String?
  darkLogoUrl       String?
  fullLogoUrl       String?
  darkFullLogoUrl   String?
  iconUrl           String?
  darkIconUrl       String?
  documentHeaderUrl String?
  documentFooterUrl String?
  stampUrl          String?
  signatureUrl      String?
  paymentTermsDays  Int     @default(30)
  invoicePrefix     String  @default("INV")
  invoiceNextNumber Int     @default(1)
  receiptPrefix     String  @default("RCT")
  receiptNextNumber Int     @default(1)

  // Headless CMS / Brand Profile
  ceoNameEn   String?
  ceoNameAr   String?
  ceoTitleEn  String?
  ceoTitleAr  String?
  ceoQuoteEn  String? @db.Text
  ceoQuoteAr  String? @db.Text
  missionEn   String? @db.Text
  missionAr   String? @db.Text
  visionEn    String? @db.Text
  visionAr    String? @db.Text
  aboutTextEn String? @db.Text

  aboutTextAr String? @db.Text

  // Terms and Rules
  termsEn String? @db.Text
  termsAr String? @db.Text
  rulesEn String? @db.Text
  rulesAr String? @db.Text

  updatedAt                    DateTime  @updatedAt
  /// Discounts up to this % of the subtotal need no approval unless a user has their own limit.
  defaultDiscountLimitPercent  Decimal   @default(5.00) @db.Decimal(5, 2)
  /// When on, every quotation goes through approval even without a discount.
  quotationsAlwaysNeedApproval Boolean   @default(false)
  /// Brand colours, fonts, radius and default mode (normalizeTheme in @platform/database/constants/theme).
  theme                        Json?
  /// Set when the first-run setup wizard finishes; until then the admin shows the wizard.
  setupCompletedAt             DateTime?
  /// Languages the company writes content in ("ar", "en"). With one language, each *En/*Ar pair holds the same text.
  contentLanguages             String[]  @default(["ar", "en"])
  /// The language shown first (website default, admin default for new users).
  primaryLanguage              String    @default("ar")
  /// Core activity (website-presets.ts BUSINESS_ACTIVITIES): drives website wording, layout and recommended modules.
  businessActivity             String?
  taglineEn                    String?
  taglineAr                    String?
  foundedYear                  Int?
  city                         String?
  country                      String?
  /// Map link shown on the contact page.
  mapUrl                       String?
}

model CompanyAsset {
  id        String   @id @default(uuid())
  assetKey  String   @unique // "logo_light", "logo_dark", "favicon", "stamp", "signature", "letterhead_header"
  title     String
  fileUrl   String
  mimeType  String?
  fileSize  Int?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model HeroBanner {
  id           String   @id @default(uuid())
  titleEn      String
  titleAr      String
  subtitleEn   String?
  subtitleAr   String?
  mediaType    String // "video", "image"
  mediaUrl     String
  posterUrl    String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  ctaLabelEn   String?
  ctaLabelAr   String?
  ctaLink      String?
  createdAt    DateTime @default(now())
  /// Sample content added by "Start with sample content"; removed in one click.
  isSample     Boolean  @default(false)
}

model PortfolioCategory {
  id           String          @id @default(uuid())
  slug         String          @unique
  nameEn       String
  nameAr       String
  displayOrder Int             @default(0)
  items        PortfolioItem[]
}

model PortfolioItem {
  id              String             @id @default(uuid())
  categoryId      String?
  category        PortfolioCategory? @relation(fields: [categoryId], references: [id])
  slug            String             @unique
  titleEn         String
  titleAr         String
  /// Media projects: who it was made for and when. Optional for products, properties, menu items…
  clientName      String?
  year            Int?
  /// Short line under the title (a product's variant, a property's area, a course's duration…).
  subtitleEn      String?
  subtitleAr      String?
  /// Shown in the company currency when set (products, menu items, properties, courses).
  price           Decimal?           @db.Decimal(15, 6)
  /// Text beside the price, e.g. "per night", "from".
  priceNoteEn     String?
  priceNoteAr     String?
  location        String?
  /// A page elsewhere for this item (shop listing, booking, registration).
  externalUrl     String?
  /// Extra facts as [{ labelEn, labelAr, valueEn, valueAr }], e.g. bedrooms, size, duration.
  attributes      Json               @default("[]")
  aspectRatio     String             @default("16:9")
  thumbnailUrl    String
  previewVideoUrl String?
  fullVideoUrl    String?
  galleryUrls     String[]           @default([])
  descriptionEn   String?
  descriptionAr   String?
  credits         Json               @default("{}")
  isFeatured      Boolean            @default(false)
  displayOrder    Int                @default(0)
  createdAt       DateTime           @default(now())
  /// Sample content added by "Start with sample content"; removed in one click.
  isSample        Boolean            @default(false)
  /// The product this catalogue item shows; its price then comes from the product.
  product         Product?
  wishlistItems   WishlistItem[]
}

model ClientLogo {
  id           String  @id @default(uuid())
  name         String
  logoUrl      String
  websiteUrl   String?
  isDarkLogo   Boolean @default(false)
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)
}

model StudioEquipment {
  id            String   @id @default(uuid())
  category      String // "cameras", "lenses", "lighting", "grip", "audio", "stages"
  nameEn        String
  nameAr        String
  brand         String?
  dailyRateBhd  Decimal? @db.Decimal(13, 6)
  quantity      Int      @default(1)
  specification String?
  descriptionEn String?
  descriptionAr String?
  imageUrl      String?
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
}

model Inquiry {
  id                     String                @id @default(uuid())
  name                   String
  email                  String
  emailNorm              String? // lower(trim(email)) for dedup matching
  phone                  String?
  phoneE164              String? // E.164 normalized phone for dedup
  companyName            String?
  serviceType            String?
  budgetRange            String?
  timeline               String?
  message                String
  status                 String                @default("new") // "new", "contacted", "qualified", "archived"
  locale                 String                @default("ar")
  source                 String                @default("website") // "website", "email", "whatsapp", "manual"
  customerId             String? // FK to resolved CrmContact
  customer               CrmContact?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  intent                 String                @default("inquiry")
  reference              String                @unique // SR-2026-000001, INQ-…, RFQ-…, CMP-…, SUG-… from ReferenceSequence
  submissionKey          String?               @unique
  requestHash            String?
  serviceIds             String[]              @default([])
  projectReference       String?
  location               String?
  assignedToId           String?
  assignedTo             User?                 @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  team                   String? // "production", "post_production", "finance", "sales", "executive", "support"
  workflowStatus         String                @default("received") // "received", "under_review", "assigned", "pending_approval", "confirmed", "returned", "in_progress", "resolved", "rejected"
  customAssignments      Json?                 @default("[]") // [{ assignedToId, assignedBy, timestamp, notes, action }]
  approvedById           String?
  approvedAt             DateTime?
  approvalNotes          String?               @db.Text
  returnReason           String?               @db.Text
  resolutionNotes        String?               @db.Text
  confirmedAt            DateTime?
  confirmedById          String?
  priority               String                @default("normal")
  resolvedAt             DateTime?
  confirmationStatus     String                @default("unknown")
  notificationStatus     String                @default("unknown")
  confirmationProviderId String?
  notificationProviderId String?
  convertedDeal          CrmDeal?              @relation("InquiryConversion")
  notes                  InquiryNote[]
  mergeFlag              Boolean               @default(false)
  requestType            String                @default("inquiry") // "SR", "CR", "inquiry", "quote_request"
  slaDueDate             DateTime?
  /// The marketing campaign (utm_campaign) that brought the visitor, when known.
  utmCampaign            String?
  /// The store order the customer is asking about.
  orderId                String?
  order                  SalesOrder?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt              DateTime              @default(now())
  quotations             Quotation[]
  communicationThreads   CommunicationThread[]
  requestEvents          RequestEvent[]
  assignments            RequestAssignment[]
  comments               RequestComment[]

  @@index([intent, status, createdAt])
  @@index([assignedToId, status, createdAt])
  @@index([team, workflowStatus])
  @@index([customerId])
  @@index([emailNorm])
  @@index([phoneE164])
  @@index([workflowStatus, createdAt])
  @@index([orderId])
}

model InquiryNote {
  id        String   @id @default(cuid())
  inquiryId String
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([inquiryId, createdAt])
}

model WebsiteContent {
  id          String    @id @default("main")
  draft       Json
  published   Json?
  previous    Json?
  revision    Int       @default(1)
  publishedAt DateTime?
  updatedAt   DateTime  @updatedAt
}

/// A website page made of blocks (cms/blocks.ts). Edited as a draft; publishing the website snapshots it.
model CmsPage {
  id               String   @id @default(uuid())
  /// "" for the homepage; otherwise lower-case words joined by dashes.
  slug             String   @unique
  /// "home" | "about" | "contact" | "custom"
  pageType         String   @default("custom")
  titleEn          String
  titleAr          String
  seoTitleEn       String?
  seoTitleAr       String?
  seoDescriptionEn String?
  seoDescriptionAr String?
  /// Ordered blocks: [{ id, type, visible, data }].
  blocks           Json     @default("[]")
  isVisible        Boolean  @default(true)
  inHeader         Boolean  @default(false)
  inFooter         Boolean  @default(false)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([sortOrder])
}

/// News, updates, posts and press releases. Body is TipTap JSON plus the sanitized HTML the website shows.
model CmsArticle {
  id               String    @id @default(uuid())
  slug             String    @unique
  titleEn          String
  titleAr          String
  excerptEn        String?   @db.Text
  excerptAr        String?   @db.Text
  bodyEn           Json?
  bodyAr           Json?
  bodyHtmlEn       String?   @db.Text
  bodyHtmlAr       String?   @db.Text
  coverUrl         String?
  /// "news" | "update" | "post" | "press_release" | a company's own category key.
  category         String    @default("news")
  tags             String[]  @default([])
  authorId         String?
  author           User?     @relation("CmsArticleAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorName       String?
  /// "draft" | "published"; a published article with a future publishAt is scheduled.
  status           String    @default("draft")
  publishAt        DateTime?
  featured         Boolean   @default(false)
  seoTitleEn       String?
  seoTitleAr       String?
  seoDescriptionEn String?
  seoDescriptionAr String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  /// Sample content added by "Start with sample content"; removed in one click.
  isSample Boolean @default(false)

  @@index([status, publishAt])
  @@index([category])
}

model CrmContact {
  id                       String                @id @default(uuid())
  firstName                String
  lastName                 String?
  email                    String?
  emailNorm                String? // lower(trim(email)) for dedup
  phone                    String?
  phoneE164                String? // E.164 normalized phone
  companyName              String?
  vatNumber                String? // buyer VAT registration, printed on tax invoices
  jobTitle                 String?
  contactType              String                @default("client") // "client", "vendor", "freelancer", "agency"
  /// "individual" | "company" | "government"
  clientKind               String                @default("individual")
  /// Companies only: "local" (registered in Bahrain, has a CR) or "foreign".
  companyOrigin            String?
  companyNameAr            String?
  /// "wll", "spc", "bsc_closed", "bsc_public", "sole_proprietorship", "partnership", "foreign_branch", "other"
  legalForm                String?
  /// Bahrain commercial registration, e.g. 142859-1. Required for local companies.
  crNumber                 String?
  crExpiryDate             DateTime?             @db.Date
  /// Foreign companies: registration number in their home country.
  registrationNumber       String?
  /// ISO 3166 alpha-2 country of registration (companies) or of the entity (government).
  registrationCountry      String?
  /// "ministry", "authority", "municipality", "semi_government", "royal_court", "embassy", "other"
  governmentType           String?
  /// Our supplier number with the government entity, quoted on its purchase orders.
  supplierNumber           String?
  requiresPurchaseOrder    Boolean               @default(false)
  /// ISO alpha-2, individuals.
  nationality              String?
  industry                 String?
  website                  String?
  /// Language the client's documents default to: "ar" | "en".
  preferredLanguage        String?
  /// Overrides the company's default payment terms for this client.
  paymentTermsDays         Int?
  addressCountry           String?
  addressCity              String?
  addressArea              String?
  addressBlock             String?
  addressRoad              String?
  addressBuilding          String?
  addressUnit              String?
  addressLine              String?
  addressState             String?
  addressPostalCode        String?
  addressPoBox             String?
  contactPersons           ClientContactPerson[]
  notes                    String?
  deals                    CrmDeal[]
  inquiries                Inquiry[]
  contracts                Contract[]
  invoices                 Invoice[]
  reviews                  Review[]
  minutesOfMeetings        MinuteOfMeeting[]
  expenses                 Expense[]
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  quotations               Quotation[]
  communicationThreads     CommunicationThread[]
  /// A supplier (contactType "vendor"): days to deliver and to pay, used as defaults on purchase orders.
  supplierLeadTimeDays     Int?
  supplierPaymentTermsDays Int?
  purchaseOrders           PurchaseOrder[]
  rfqQuotes                RfqQuote[]
  supplierBills            SupplierBill[]
  /// The website customer account this contact belongs to.
  customer                 Customer?

  @@index([emailNorm])
  @@index([phoneE164])
  @@index([clientKind])
  @@index([crNumber])
  @@index([createdAt])
}

/// A point of contact at a company or government client. The primary one is mirrored onto the client
/// (name, email, phone, job title) so documents and messages keep using those fields.
model ClientContactPerson {
  id           String     @id @default(uuid())
  contactId    String
  contact      CrmContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  fullName     String
  position     String?
  department   String?
  email        String?
  phone        String?
  isPrimary    Boolean    @default(false)
  notes        String?
  displayOrder Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([contactId, displayOrder])
}

model CrmDeal {
  id                String            @id @default(uuid())
  contactId         String?
  contact           CrmContact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  sourceInquiryId   String?           @unique
  sourceInquiry     Inquiry?          @relation("InquiryConversion", fields: [sourceInquiryId], references: [id], onDelete: Restrict)
  title             String
  dealStage         String            @default("lead") // DealPipelineStage.id
  dealValue         Decimal           @default(0.000) @db.Decimal(15, 6)
  currency          String
  probability       Int               @default(50)
  expectedCloseDate DateTime?         @db.Date
  shootDate         DateTime?         @db.Date
  lostReason        String?
  assignedTo        String?
  assignee          User?             @relation(fields: [assignedTo], references: [id], onDelete: SetNull)
  notes             String?
  invoices          Invoice[]
  expenses          Expense[]
  calendarEvents    CalendarEvent[]
  contracts         Contract[]
  minutesOfMeetings MinuteOfMeeting[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  expenseClaims ExpenseClaim[]
  quotations    Quotation[]

  @@index([contactId])
  @@index([dealStage])
  @@index([assignedTo])
  @@index([createdAt])
}

/// The company's sales pipeline. Stage ids are what CrmDeal.dealStage stores; system stages are the ones
/// quotations and invoices move deals into, so they can be renamed and reordered but not removed.
model DealPipelineStage {
  id          String   @id
  /// Null shows the built-in label for the company's activity (admin copy `stages.<id>`).
  nameEn      String?
  nameAr      String?
  sortOrder   Int
  probability Int      @default(50)
  /// "open", "won" or "lost".
  kind        String   @default("open")
  color       String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}

model Invoice {
  id               String              @id @default(uuid())
  dealId           String?
  deal             CrmDeal?            @relation(fields: [dealId], references: [id], onDelete: SetNull)
  invoiceNumber    String              @unique
  clientId         String?
  client           CrmContact?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  issueDate        DateTime            @default(now()) @db.Date
  dueDate          DateTime            @db.Date
  subtotal         Decimal             @default(0.000) @db.Decimal(15, 6)
  vatEnabled       Boolean             @default(false)
  vatPercentage    Decimal             @default(10.00) @db.Decimal(5, 2)
  vatAmount        Decimal             @default(0.000) @db.Decimal(15, 6)
  /// Sum of the other taxes on this invoice (see DocumentTax); VAT stays in vatAmount.
  otherTaxAmount   Decimal             @default(0.000) @db.Decimal(15, 6)
  taxes            DocumentTax[]
  discountType     String              @default("none") // "none", "percentage", "fixed"
  discountValue    Decimal             @default(0.000) @db.Decimal(15, 6)
  discountAmount   Decimal             @default(0.000) @db.Decimal(15, 6)
  totalAmount      Decimal             @default(0.000) @db.Decimal(15, 6)
  currency         String
  language         String              @default("ar") // "ar", "en"
  status           String              @default("draft") // "draft", "sent", "partially_paid", "paid", "overdue", "void"
  approvalStatus   String              @default("draft") // "draft", "submitted", "approved", "rejected"
  approvalRevision Int                 @default(1)
  contentHash      String?
  pdfStoragePath   String?
  deliveryChannel  String?
  deliveredAt      DateTime?           @db.Timestamptz
  notesEn          String?
  notesAr          String?
  createdById      String?
  createdBy        User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lineItems        InvoiceLineItem[]
  payments         Payment[]
  allocations      PaymentAllocation[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  expenseClaims         ExpenseClaim[]
  /// The salesperson credited with this invoice (from its quotation, else its issuer).
  salesOwnerId          String?
  salesOwner            User?                  @relation("InvoiceSalesOwner", fields: [salesOwnerId], references: [id], onDelete: SetNull)
  /// Signed and stamped after approval by the person who sends it; the signature is snapshotted.
  signedById            String?
  signedBy              User?                  @relation("InvoiceSigner", fields: [signedById], references: [id], onDelete: SetNull)
  signedAt              DateTime?
  signerSignatureUrl    String?
  quotation             Quotation?
  communicationMessages CommunicationMessage[]

  @@index([clientId])
  @@index([dealId])
  @@index([status])
  @@index([approvalStatus])
  @@index([issueDate])
  @@index([createdAt])
  @@index([salesOwnerId])
}

model InvoiceLineItem {
  id            String   @id @default(uuid())
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceId     String?
  service       Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  descriptionEn String
  descriptionAr String?
  quantity      Decimal  @default(1.00) @db.Decimal(10, 2)
  unitPrice     Decimal  @default(0.000) @db.Decimal(15, 6)
  lineTotal     Decimal  @default(0.000) @db.Decimal(15, 6)
  displayOrder  Int      @default(0)

  @@index([serviceId])
  @@index([invoiceId, displayOrder])
}

model Payment {
  id                  String              @id @default(uuid())
  invoiceId           String
  invoice             Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  receiptNumber       String              @unique
  paymentDate         DateTime            @default(now()) @db.Date
  amount              Decimal             @db.Decimal(15, 6)
  currency            String
  paymentMethod       String              @default("bank_transfer") // "bank_transfer", "cash", "cheque", "card", "online"
  referenceNumber     String?
  notes               String?
  receiptPdfPath      String?
  notificationChannel String?
  notificationSent    Boolean             @default(false)
  createdById         String?
  createdBy           User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  allocations         PaymentAllocation[]
  settlement          BankSettlement?
  createdAt           DateTime            @default(now())

  /// Signed and stamped after approval by the person who sends it; the signature is snapshotted.
  signedById         String?
  signedBy           User?     @relation("ReceiptSigner", fields: [signedById], references: [id], onDelete: SetNull)
  signedAt           DateTime?
  signerSignatureUrl String?

  @@index([invoiceId])
  @@index([paymentDate])
  @@index([paymentMethod])
  @@index([createdAt])
}

model ExpenseCategory {
  id                String             @id @default(uuid())
  slug              String             @unique
  nameEn            String
  nameAr            String
  color             String             @default("#9EADA9")
  displayOrder      Int                @default(0)
  /// "cost_of_sales" (project costs), "operating" (overheads) or "payroll".
  kind              String             @default("operating")
  /// Built-in categories can be renamed or hidden but never deleted.
  isSystem          Boolean            @default(false)
  isActive          Boolean            @default(true)
  expenses          Expense[]
  claims            ExpenseClaim[]
  recurringExpenses RecurringExpense[]
}

model Expense {
  id                 String           @id @default(uuid())
  categoryId         String?
  category           ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  dealId             String?
  deal               CrmDeal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)
  /// Client the cost was incurred for; set from the deal when a deal is chosen.
  clientId           String?
  client             CrmContact?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  /// "deal" | "client" | "internal"
  scope              String           @default("internal")
  paymentMethod      String?
  descriptionEn      String
  descriptionAr      String?
  amount             Decimal          @db.Decimal(15, 6)
  netAmount          Decimal          @default(0.000) @db.Decimal(15, 6)
  inputVatAmount     Decimal          @default(0.000) @db.Decimal(15, 6)
  isVatRecoverable   Boolean          @default(true)
  taxInvoiceNumber   String?
  currency           String
  expenseDate        DateTime         @default(now()) @db.Date
  vendorName         String?
  receiptUrl         String?
  isBillable         Boolean          @default(false)
  isRecurring        Boolean          @default(false)
  recurrenceInterval String? // "monthly", "quarterly", "yearly"
  notes              String?
  status             String           @default("approved") // "pending" | "approved" | "rejected"; set by the expense approval policy
  reviewNotes        String?
  createdById        String?
  createdBy          User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime         @default(now())

  claim              ExpenseClaim?
  commissionPayout   CommissionPayout?
  /// The recurring bill this expense was recorded from.
  recurringExpenseId String?
  recurringExpense   RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)

  @@index([dealId])
  @@index([clientId])
  @@index([categoryId])
  @@index([currency, expenseDate])
  @@index([status])
  @@index([createdAt])
  @@index([createdById])
}

model CalendarEvent {
  id                    String   @id @default(uuid())
  title                 String
  titleAr               String?
  description           String?
  startDate             DateTime
  endDate               DateTime
  allDay                Boolean  @default(false)
  location              String?
  color                 String?
  eventType             String   @default("meeting") // "meeting", "shoot", "deadline", "reminder"
  dealId                String?
  deal                  CrmDeal? @relation(fields: [dealId], references: [id], onDelete: SetNull)
  createdById           String?
  createdBy             User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  googleEventId         String?
  googleCalendarId      String?
  recurrence            String?
  reminders             Json?
  attendees             Json?
  /// "private" | "team" | "department" | "company" | "custom" — see queries/calendar.ts for who sees what.
  visibility            String   @default("company")
  audienceUserIds       String[] @default([])
  audienceDepartmentIds String[] @default([])
  audienceRoles         String[] @default([])
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  expenseClaims ExpenseClaim[]

  @@index([dealId])
  @@index([startDate])
  @@index([createdById])
}

model ActivityLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  action      String // "create", "update", "delete", "login", "logout", "export", "stage_change", "void", "approve"
  entityType  String // "invoice", "deal", "contact", "expense", "user", "banner", "contract", etc.
  entityId    String?
  details     Json?
  diffPayload Json? // { before: {...}, after: {...} }
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

model Notification {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  title         String
  message       String
  type          String    @default("info") // "info", "warning", "success", "action"
  entityType    String?
  entityId      String?
  messageKey    String?
  messageParams Json?
  actionUrl     String?
  eventKey      String?
  isRead        Boolean   @default(false)
  /// Hidden from the person's inbox (kept for the audit trail until they delete it).
  hiddenAt      DateTime?
  createdAt     DateTime  @default(now())
  /// When the admin handed it to the notify service, which owns the inbox from then on (docs/adr/0012). Rows are
  /// written here in the producer's transaction; read state lives in notify.
  handedOverAt  DateTime?

  @@index([userId, isRead, createdAt])
  @@index([userId, hiddenAt, createdAt])
  @@index([eventKey])
  @@index([handedOverAt, createdAt])
}

model Tag {
  id         String   @id @default(uuid())
  name       String
  nameAr     String?
  color      String   @default("#2563EB")
  entityType String // "deal", "contact", "invoice", "expense"
  createdAt  DateTime @default(now())
}

model Attachment {
  id           String   @id @default(uuid())
  fileName     String
  fileUrl      String
  fileSize     Int?
  mimeType     String?
  entityType   String
  entityId     String
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([fileUrl])
}

model Permission {
  id             String   @id @default(uuid())
  role           String // "super_admin", "admin", "finance_manager", "sales", "marketing", "production_manager", "producer", "editor", "accountant", "viewer"
  roleDefinition Role     @relation(fields: [role], references: [id], onDelete: Cascade)
  resource       String // "invoices", "payments", "expenses", "finance_analytics", "deals", "contacts", "leads", "contracts", "banners", "portfolio", "clients", "equipment", "users", "settings", "audit_logs"
  action         String // "read", "write", "delete", "export", "approve"
  allowed        Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@unique([role, resource, action])
  @@index([role])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model DocumentTemplate {
  id        String     @id @default(uuid())
  slug      String     @unique // "invoice_standard", "receipt_cash", "nda_bahrain", "commercial_contract"
  nameEn    String
  nameAr    String?
  category  String // "invoice", "receipt", "contract", "legal"
  bodyHtml  String?    @db.Text
  bodyJson  Json?
  version   Int        @default(1)
  isActive  Boolean    @default(true)
  contracts Contract[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Contract {
  id             String            @id @default(uuid())
  contractNumber String            @unique
  dealId         String?
  deal           CrmDeal?          @relation(fields: [dealId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        CrmContact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  templateId     String?
  template       DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  titleEn        String
  titleAr        String?
  bodyHtml       String?           @db.Text
  status         String            @default("draft") // "draft", "sent", "signed", "expired", "cancelled"
  signatureHash  String? // SHA-256 of signature image/data
  signedAt       DateTime?
  validFrom      DateTime?         @db.Date
  validUntil     DateTime?         @db.Date
  pdfStoragePath String?
  metadata       Json? // Additional flexible fields
  createdById    String?
  createdBy      User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([dealId])
  @@index([contactId])
}

model MinuteOfMeeting {
  emailJobs        EmailJob[]
  id               String      @id @default(uuid())
  momNumber        String      @unique // e.g. "MOM-2026-001"
  title            String
  titleAr          String?
  meetingDate      DateTime    @db.Date
  startTime        String? // e.g. "10:00 AM"
  endTime          String? // e.g. "11:30 AM"
  location         String? // e.g. "Main Studio", "Zoom Virtual Room", "Client HQ"
  dealId           String?
  deal             CrmDeal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  clientId         String?
  client           CrmContact? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  attendees        Json        @default("[]") // [{ name, role, email, organization, attended: boolean }]
  agenda           String      @db.Text
  discussionPoints Json        @default("[]") // [{ topic, notes, speaker }]
  actionItems      Json        @default("[]") // [{ task, assignee, dueDate, status: 'pending' | 'in_progress' | 'completed' }]
  decisions        Json?       @default("[]") // string[]
  notes            String?     @db.Text
  status           String      @default("draft") // "draft", "in_review", "approved", "shared"
  createdById      String?
  createdBy        User?       @relation("MomCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedById     String?
  approvedBy       User?       @relation("MomApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  signatureUrl     String? // User signature snapshot at signing
  pdfStoragePath   String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([clientId])
  @@index([dealId])
  @@index([meetingDate])
  @@index([status])
}

model GeneratedDocument {
  id               String   @id @default(uuid())
  documentType     String // "invoice_pdf", "receipt_pdf", "contract_pdf", "custom"
  sourceEntityType String // "invoice", "payment", "contract"
  sourceEntityId   String
  fileName         String
  storagePath      String
  fileSize         Int?
  checksum         String? // SHA-256 for integrity
  generatedById    String?
  generatedBy      User?    @relation(fields: [generatedById], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())

  @@index([sourceEntityType, sourceEntityId])
}

model CompanyDocument {
  id             String    @id @default(uuid())
  titleEn        String
  titleAr        String?
  category       String // "cr_license", "vat_certificate", "company_profile", "bylaws", "standard_contract"
  documentNumber String?
  fileUrl        String
  fileSize       Int?
  mimeType       String?
  validFrom      DateTime? @db.Date
  validUntil     DateTime? @db.Date
  notes          String?
  uploadedById   String?
  uploadedBy     User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([category])
}

model Service {
  id            String            @id @default(uuid())
  code          String?           @unique
  nameEn        String
  nameAr        String
  category      String            @default("general")
  descriptionEn String?
  descriptionAr String?
  unit          String            @default("day") // "hour", "day", "project", "unit", "minute"
  defaultRate   Decimal           @default(0.000) @db.Decimal(15, 6)
  isActive      Boolean           @default(true)
  displayOrder  Int               @default(0)
  isPublic      Boolean           @default(false)
  imageUrl      String?
  lineItems     InvoiceLineItem[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  /// Sample content added by "Start with sample content"; removed in one click.
  isSample Boolean @default(false)

  @@index([category])
  @@index([isActive])
}

// ==========================================
// ENTERPRISE & HEADLESS CMS MODELS
// ==========================================

model SocialLink {
  id           String   @id @default(uuid())
  platform     String // "instagram", "linkedin", "youtube", "facebook", "twitter", "tiktok", "vimeo", "snapchat", etc.
  url          String
  icon         String? // lucide icon name
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Role {
  users       User[]
  permissions Permission[]
  id          String       @id @default(cuid()) // e.g. "sales_lead", "agency_partner"
  nameEn      String
  nameAr      String
  isSystem    Boolean      @default(false) // Prevents deletion of core roles
  createdAt   DateTime     @default(now())
}

/// Which records a role sees in an area (constants/data-scope.ts): "own", "department" or "all".
model RoleDataScope {
  role  String
  area  String
  scope String

  @@id([role, area])
}


model Review {
  id             String      @id @default(cuid())
  clientId       String?
  client         CrmContact? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  originalLocale String?
  submissionKey  String?     @unique
  requestHash    String?
  authorEn       String
  authorAr       String
  companyEn      String?
  companyAr      String?
  quoteEn        String      @db.Text
  quoteAr        String      @db.Text
  rating         Int         @default(5) // 1 to 5 stars
  isApproved     Boolean     @default(false)
  sortOrder      Int         @default(0)
  year           String      @default("2026")
  createdAt      DateTime    @default(now())
}

model Faq {
  id          String   @id @default(cuid())
  questionEn  String   @db.Text
  questionAr  String   @db.Text
  answerEn    String   @db.Text
  answerAr    String   @db.Text
  category    String   @default("general")
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  /// Sample content added by "Start with sample content"; removed in one click.
  isSample    Boolean  @default(false)
}

model Statistic {
  id          String  @id @default(cuid())
  value       String // e.g., "150+" or "8K"
  labelEn     String
  labelAr     String
  subLabelEn  String?
  subLabelAr  String?
  icon        String? // Lucide icon name, e.g. "Film"
  sortOrder   Int     @default(0)
  /// "manual" uses value as typed; "preset" computes it from live data.
  source      String  @default("manual")
  /// projects_delivered | clients_served | team_members | portfolio_projects | five_star_reviews | years_in_business
  preset      String?
  /// Preset input, e.g. the founding year for years_in_business.
  presetParam Int?
  /// Round computed values down to this step (10 → 157 shows 150) before the suffix.
  roundTo     Int?
  suffix      String?
  /// Sample content added by "Start with sample content"; removed in one click.
  isSample    Boolean @default(false)
}

// Durable cross-app cache invalidation, committed with publication.
model RevalidationJob {
  id            String    @id @default(cuid())
  eventKey      String    @unique
  payload       Json
  status        String    @default("pending")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?
  deliveredAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([status, nextAttemptAt])
}

model AbuseWindow {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

model MfaRecoveryCode {
  id       String    @id @default(uuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String    @unique
  usedAt   DateTime?

  @@index([userId])
}

model EmailJob {
  id             String           @id @default(uuid())
  eventKey       String           @unique
  momId          String?
  mom            MinuteOfMeeting? @relation(fields: [momId], references: [id], onDelete: Restrict)
  createdById    String?
  createdBy      User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  recipient      String
  subject        String
  html           String           @db.Text
  attachmentName String
  attachment     Bytes
  status         String           @default("pending")
  attempts       Int              @default(0)
  nextAttemptAt  DateTime         @default(now())
  providerId     String?
  lastError      String?
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())

  @@index([status, nextAttemptAt])
  @@index([momId, createdAt])
}

model SocialInsightSnapshot {
  id              String   @id @default(uuid())
  platform        String
  sourceProvider  String
  sourceAccountId String
  periodDays      Int
  periodStart     DateTime @db.Date
  periodEnd       DateTime @db.Date
  timeZone        String
  metrics         Json
  nativeMetrics   Json
  recordedAt      DateTime @default(now())

  @@unique([platform, sourceProvider, sourceAccountId, periodDays, periodStart, periodEnd], name: "account_period", map: "SocialInsightSnapshot_account_period_key")
  @@index([platform, sourceProvider, sourceAccountId, periodDays, recordedAt], map: "SocialInsightSnapshot_account_period_fetched_idx")
}

model AuthChallenge {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  type      String // "invitation", "password_reset", "login_otp", "mfa_setup"
  codeHash  String // bcrypt hash of the plain token/otp
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email, type])
}

model Quotation {
  id              String @id @default(uuid())
  quotationNumber String @unique
  revision        Int    @default(1)

  dealId    String?
  deal      CrmDeal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  clientId  String?
  client    CrmContact? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  inquiryId String?
  inquiry   Inquiry?    @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  invoiceId String?     @unique
  invoice   Invoice?    @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  issueDate      DateTime @default(now()) @db.Date
  validUntilDate DateTime @db.Date

  subtotal       Decimal       @default(0.000) @db.Decimal(15, 6)
  vatEnabled     Boolean       @default(false)
  vatPercentage  Decimal       @default(10.00) @db.Decimal(5, 2)
  vatAmount      Decimal       @default(0.000) @db.Decimal(15, 6)
  otherTaxAmount Decimal       @default(0.000) @db.Decimal(15, 6)
  taxes          DocumentTax[]
  discountType   String        @default("none") // "none", "percentage", "fixed"
  discountValue  Decimal       @default(0.000) @db.Decimal(15, 6)
  discountAmount Decimal       @default(0.000) @db.Decimal(15, 6)
  totalAmount    Decimal       @default(0.000) @db.Decimal(15, 6)
  currency       String
  language       String        @default("ar") // "ar", "en"

  status             String   @default("draft") // "draft", "submitted", "approved", "issued", "accepted", "declined", "expired", "cancelled"
  acceptanceEvidence String?
  approvalRevision   Int      @default(1)
  contentHash        String?
  rawRate            Decimal? @db.Decimal(14, 6)
  fxMarginPercent    Decimal  @default(0.00) @db.Decimal(5, 2)
  effectiveRate      Decimal? @db.Decimal(14, 6)

  pdfStoragePath  String?
  deliveryChannel String?
  deliveredAt     DateTime? @db.Timestamptz

  termsEn String?
  termsAr String?

  createdById String?
  createdBy   User?               @relation("QuotationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lineItems   QuotationLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The salesperson credited with this quotation (defaults to its issuer).
  salesOwnerId          String?
  salesOwner            User?                  @relation("QuotationSalesOwner", fields: [salesOwnerId], references: [id], onDelete: SetNull)
  /// Signed and stamped after approval by the person who sends it; the signature is snapshotted.
  signedById            String?
  signedBy              User?                  @relation("QuotationSigner", fields: [signedById], references: [id], onDelete: SetNull)
  signedAt              DateTime?
  signerSignatureUrl    String?
  communicationMessages CommunicationMessage[]

  @@index([clientId])
  @@index([dealId])
  @@index([inquiryId])
  @@index([status])
  @@index([validUntilDate])
  @@index([salesOwnerId])
  @@index([createdAt])
}

model QuotationLineItem {
  id            String    @id @default(uuid())
  quotationId   String
  quotation     Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  descriptionEn String
  descriptionAr String?
  quantity      Decimal   @default(1.00) @db.Decimal(10, 2)
  unitPrice     Decimal   @default(0.000) @db.Decimal(15, 6)
  lineTotal     Decimal   @default(0.000) @db.Decimal(15, 6)
  orderIndex    Int       @default(0)

  @@index([quotationId])
}

model CommunicationThread {
  id         String      @id @default(uuid())
  subject    String
  status     String      @default("open") // "open", "resolved", "snoozed"
  contactId  String?
  contact    CrmContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  inquiryId  String?
  inquiry    Inquiry?    @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  assignedTo String?
  assignee   User?       @relation(fields: [assignedTo], references: [id], onDelete: SetNull)

  messages CommunicationMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactId])
  @@index([inquiryId])
}

model CommunicationMessage {
  id       String               @id @default(uuid())
  threadId String?
  thread   CommunicationThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)

  messageId String? @unique // SMTP Message-ID
  inReplyTo String? // SMTP In-Reply-To

  direction String // "inbound", "outbound"
  fromEmail String
  toEmail   String
  subject   String
  bodyText  String? @db.Text
  bodyHtml  String? @db.Text

  status      String @default("queued") // "queued", "accepted", "delivered", "bounced", "failed"
  deliveryLog Json? // Array of delivery events from webhooks

  // Relations to sent documents
  invoiceId   String?
  invoice     Invoice?   @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  quotationId String?
  quotation   Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)

  attachments MessageAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([threadId])
  @@index([messageId])
}

model MessageAttachment {
  id            String               @id @default(uuid())
  messageId     String
  message       CommunicationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  filename      String
  contentType   String
  size          Int
  storagePath   String
  isQuarantined Boolean              @default(false)
  createdAt     DateTime             @default(now())

  @@index([messageId])
}

/// A post or video fetched from a connected social account, with its latest engagement counts.
model SocialPost {
  id              String               @id @default(uuid())
  platform        String // "facebook", "instagram", "youtube", "tiktok", "x", "linkedin"
  externalId      String
  sourceProvider  String?
  sourceAccountId String?
  snapshots       SocialPostSnapshot[]
  caption         String?              @db.Text
  mediaType       String? // "image", "video", "carousel", "text", "reel"
  permalink       String?
  thumbnailUrl    String?
  publishedAt     DateTime
  likes           Float?
  comments        Float?
  shares          Float?
  views           Float?
  reach           Float?
  saves           Float?
  fetchedAt       DateTime             @default(now())
  createdAt       DateTime             @default(now())

  @@unique([platform, externalId])
  @@index([platform, publishedAt])
}

/// Provider readings retained independently of the latest post counters.
model SocialPostSnapshot {
  id              String     @id @default(uuid())
  postId          String
  post            SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  sourceAccountId String
  recordedAt      DateTime   @default(now())
  counters        Json

  @@unique([postId, recordedAt])
  @@index([recordedAt])
}

/// Planned social content: drafted, scheduled and marked published by the marketing team.
model SocialContentPlan {
  id           String    @id @default(uuid())
  title        String
  caption      String?   @db.Text
  platforms    String[]
  mediaUrl     String?
  scheduledFor DateTime?
  status       String    @default("idea") // "idea", "draft", "scheduled", "published", "cancelled"
  publishedUrl String?
  assigneeId   String?
  assignee     User?     @relation("SocialPlanAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById  String
  createdBy    User      @relation("SocialPlanCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, scheduledFor])
}

model SocialMetric {
  id              String   @id @default(uuid())
  platform        String // "facebook", "instagram", "youtube", "whatsapp"
  metricType      String // "followers", "views", "engagement", "messages_sent", "messages_read"
  value           Float
  sourceProvider  String?
  sourceAccountId String?
  recordedAt      DateTime @default(now())

  // To track freshness and handle unavailable data truthfully
  isStale     Boolean @default(false)
  errorStatus String? // If there was an error fetching the data

  createdAt DateTime @default(now())

  @@index([platform, metricType])
  @@index([recordedAt])
  @@index([sourceProvider, sourceAccountId, recordedAt])
}

// ==========================================
// WORKFLOW, APPROVALS & IDENTITY MODELS
// ==========================================

model ProfileChangeRequest {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation("UserProfileChanges", fields: [userId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User      @relation("ProfileChangeRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  managerId     String?
  manager       User?     @relation("ProfileChangeManager", fields: [managerId], references: [id], onDelete: SetNull)
  status        String    @default("pending") // "pending", "approved", "rejected", "cancelled"
  oldValues     Json
  newValues     Json
  reviewedAt    DateTime?
  reviewNotes   String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, status])
  @@index([managerId, status])
}

model ApprovalRequest {
  id             String             @id @default(uuid())
  targetType     String // "quotation", "invoice", "profile_change", "leave_request", "payroll_run"
  targetId       String
  revision       Int                @default(1)
  contentHash    String
  status         String             @default("pending") // "pending", "approved", "rejected", "superseded"
  requestedById  String
  requestedBy    User               @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  policySnapshot Json
  diffPayload    Json?
  discountReason String?            @db.Text
  decisions      ApprovalDecision[]
  policyId       String?
  policy         ApprovalPolicy?    @relation(fields: [policyId], references: [id], onDelete: SetNull)
  currentStep    Int                @default(1)
  approverIds    String[]           @default([]) // eligible deciders for currentStep, resolved at submit/advance time
  selfApproved   Boolean            @default(false) // decided by the requester because no other approver existed
  /// Facts the policy conditions were evaluated against: { amount (BHD), days, discountPercent }.
  metrics        Json?
  stepStartedAt  DateTime           @default(now())
  remindedAt     DateTime?
  escalatedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([targetType, targetId, revision])
  @@index([status, targetType])
  @@index([requestedById])
}

model ApprovalDecision {
  id                String          @id @default(uuid())
  approvalRequestId String
  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  decision          String // "approved", "rejected"
  decidedById       String
  decidedBy         User            @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  reason            String?         @db.Text
  step              Int             @default(1)
  /// The approver's signature drawn at the moment of approving (PNG data URL), when the document requires it.
  signatureData     String?
  decidedAt         DateTime        @default(now())

  @@index([approvalRequestId])
  @@index([decidedById])
}

/// Who must approve each kind of request. One policy per target type, editable in Settings → Approvals.
model ApprovalPolicy {
  id                 String               @id @default(uuid())
  targetType         String               @unique // see APPROVAL_TARGET_TYPES in src/constants/approvals.ts
  enabled            Boolean              @default(true) // disabled = requests are approved on submit
  allowSelfApproval  Boolean              @default(false)
  autoApproveRoles   String[]             @default([])
  /// Re-notify the current approvers once a request has waited this long.
  reminderAfterHours Int?
  steps              ApprovalPolicyStep[]
  requests           ApprovalRequest[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model ApprovalPolicyStep {
  id                 String         @id @default(uuid())
  policyId           String
  policy             ApprovalPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  order              Int
  approverMode       String // "manager" | "department_manager" | "role" | "user" | "permission"
  roleKey            String?
  userId             String?
  permission         String? // "resource:action"
  /// The step applies only when every set condition holds; otherwise it is skipped.
  minAmount          Decimal?       @db.Decimal(17, 6) // BHD
  minDays            Decimal?       @db.Decimal(6, 2)
  minDiscountPercent Decimal?       @db.Decimal(5, 2)
  /// After this many hours waiting at this step, the escalation approver is added.
  escalateAfterHours Int?
  escalateMode       String? // "role" | "user"
  escalateRoleKey    String?
  escalateUserId     String?

  @@unique([policyId, order])
}

model ReferenceSequence {
  id         String   @id // e.g. "SR_2026", "CR_2026", "QTE_2026", "INV_2026"
  prefix     String
  year       Int
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model RequestEvent {
  id        String   @id @default(uuid())
  inquiryId String
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation("RequestEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  eventType String // "status_change", "assignment", "comment", "priority_change", "reopen", "resolved"
  details   Json
  createdAt DateTime @default(now())

  @@index([inquiryId, createdAt])
}

model RequestAssignment {
  id           String   @id @default(uuid())
  inquiryId    String
  inquiry      Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  assignedToId String
  assignedTo   User     @relation("RequestAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  assignedById String
  assignedBy   User     @relation("RequestAssigner", fields: [assignedById], references: [id], onDelete: Restrict)
  team         String?
  reason       String?  @db.Text
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([inquiryId, active])
  @@index([assignedToId, active])
}

model RequestComment {
  id              String   @id @default(uuid())
  inquiryId       String
  inquiry         Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  authorId        String
  author          User     @relation("RequestCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  body            String   @db.Text
  isClientVisible Boolean  @default(false)
  /// For replies sent to the customer: email | whatsapp.
  channel         String?
  attachments     Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([inquiryId, createdAt])
}

// ==========================================
// MULTI-CURRENCY, FX & SETTLEMENT MODELS
// ==========================================

model ExchangeRateSnapshot {
  id             String   @id @default(uuid())
  baseCurrency   String // e.g. "BHD"
  quoteCurrency  String // e.g. "USD", "SAR"
  rate           Decimal  @db.Decimal(14, 6)
  effectiveDate  DateTime @db.Date
  fetchedAt      DateTime @default(now())
  provider       String // e.g. "frankfurter", "cbb_manual"
  sourceEvidence String?
  createdAt      DateTime @default(now())

  @@unique([baseCurrency, quoteCurrency, effectiveDate])
}

model DocumentFx {
  id             String   @id @default(uuid())
  documentType   String // "quotation", "invoice"
  documentId     String
  baseAmount     Decimal  @db.Decimal(15, 6)
  targetAmount   Decimal  @db.Decimal(15, 6)
  rawRate        Decimal  @db.Decimal(14, 6)
  marginPercent  Decimal  @default(3.00) @db.Decimal(5, 2)
  effectiveRate  Decimal  @db.Decimal(14, 6)
  rateSnapshotId String?
  createdAt      DateTime @default(now())

  @@unique([documentType, documentId])
}

model PaymentAllocation {
  id              String   @id @default(uuid())
  paymentId       String
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  allocatedAmount Decimal  @db.Decimal(15, 6)
  currency        String
  allocatedAt     DateTime @default(now())

  @@index([paymentId])
  @@index([invoiceId])
}

model BankSettlement {
  id               String   @id @default(uuid())
  paymentId        String   @unique
  payment          Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  settlementDate   DateTime @db.Date
  receivedAmount   Decimal  @db.Decimal(15, 6)
  receivedCurrency String
  settledAmountBhd Decimal  @db.Decimal(15, 6)
  bankFeeBhd       Decimal  @default(0.000) @db.Decimal(15, 6)
  fxGainLossBhd    Decimal  @default(0.000) @db.Decimal(15, 6)
  bankReference    String?
  status           String   @default("settled") // "settled", "unreconciled"
  createdAt        DateTime @default(now())
}

// ==========================================
// HRMS & PAYROLL MODELS
// ==========================================

model Department {
  id           String       @id @default(uuid())
  code         String       @unique
  nameEn       String
  nameAr       String
  /// DEPARTMENT_CATALOGUE key when it was created from the catalogue.
  catalogueKey String?
  /// Nesting: sub-departments roll up to their parent (data scope, approvals, org chart).
  parentId     String?
  parent       Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Department[] @relation("DepartmentTree")
  /// User ids of the head and their deputy.
  managerId    String?
  deputyId     String?
  costCentre   String?
  sortOrder    Int          @default(0)
  isActive     Boolean      @default(true)
  employees    Employee[]
  users        User[]       @relation("UserDepartment")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([parentId])
}

model Employee {
  id                 String                 @id @default(uuid())
  employeeNumber     String                 @unique
  userId             String?                @unique
  user               User?                  @relation("UserEmployee", fields: [userId], references: [id], onDelete: SetNull)
  departmentId       String?
  department         Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  firstNameEn        String
  lastNameEn         String
  firstNameAr        String
  lastNameAr         String
  email              String?
  phone              String?
  cprNumber          String?
  cprExpiryDate      DateTime?              @db.Date
  /// ISO 3166 alpha-2.
  nationality        String?
  dateOfBirth        DateTime?              @db.Date
  /// "male" | "female"
  gender             String?
  passportNumber     String?
  /// ISO alpha-2 country that issued the passport.
  passportCountry    String?
  passportExpiryDate DateTime?              @db.Date
  credentials        EmployeeCredential[]
  recurringPay       EmployeeRecurringPay[]
  assetsHeld         Asset[]                @relation("AssetHolder")
  assetHandovers     AssetHandover[]
  workHandovers      EmployeeHandover[]
  jobTitleEn         String
  jobTitleAr         String
  hireDate           DateTime               @db.Date
  status             String                 @default("active") // "active", "on_leave", "suspended", "terminated"
  leaveBalanceDays   Decimal                @default(30.00) @db.Decimal(5, 2)
  salaryDocuments    SalaryDocument[]
  employmentRecords  EmploymentRecord[]
  leaveRequests      LeaveRequest[]
  leaveAdjustments   LeaveAdjustment[]
  attendanceEntries  AttendanceEntry[]
  payrollItems       PayrollItem[]
  payslips           Payslip[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  supportReimbursements SupportReimbursement[]
  gosiRecords           EmployeeGosiRecord[]
  supports              EmployeeSupport[]
  finalSettlements      FinalSettlement[]
  officialLetters       OfficialLetter[]
  deliveries            Shipment[]             @relation("ShipmentDriver")
  routeSheets           RouteSheet[]           @relation("RouteSheetDriver")
  codSettlements        CodSettlement[]        @relation("CodSettlementDriver")

  @@index([departmentId])
  @@index([status])
  @@index([firstNameEn, lastNameEn])
}

model EmploymentRecord {
  id                 String    @id @default(uuid())
  employeeId         String
  employee           Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  contractType       String    @default("full_time") // "full_time", "part_time", "contract"
  basicSalary        Decimal   @db.Decimal(15, 6)
  housingAllowance   Decimal   @default(0.000) @db.Decimal(15, 6)
  transportAllowance Decimal   @default(0.000) @db.Decimal(15, 6)
  otherAllowances    Decimal   @default(0.000) @db.Decimal(15, 6)
  payrollSettings    Json?
  effectiveFrom      DateTime  @db.Date
  effectiveTo        DateTime? @db.Date
  isCurrent          Boolean   @default(true)
  createdAt          DateTime  @default(now())

  @@index([employeeId, isCurrent])
}

model LeaveType {
  id                  String            @id @default(uuid())
  code                String            @unique // "annual", "sick", "maternity", "emergency", "unpaid"
  nameEn              String
  nameAr              String
  daysAllowedPerYear  Decimal           @default(30.00) @db.Decimal(5, 2)
  /// Kept in step with payPercent > 0 for older readers.
  isPaid              Boolean           @default(true)
  /// Share of the daily rate paid while on this leave: 100 = full pay, 50 = half pay, 0 = unpaid.
  payPercent          Int               @default(100)
  /// Optional pay bands by days taken in the year, e.g. [{"upToDays":15,"percent":100},{"upToDays":35,"percent":50}].
  payTiers            Json?
  /// "annual" = full entitlement each year, "monthly" = earned per completed month, "none" = no balance kept.
  accrual             String            @default("annual")
  eligibleAfterMonths Int               @default(0)
  maxCarryOverDays    Decimal           @default(0) @db.Decimal(5, 2)
  maxDaysPerRequest   Decimal?          @db.Decimal(5, 2)
  allowHalfDay        Boolean           @default(true)
  allowHours          Boolean           @default(false)
  /// Count weekends and holidays inside the leave (e.g. maternity) instead of working days only.
  countCalendarDays   Boolean           @default(false)
  requiresAttachment  Boolean           @default(false)
  /// Approved leave of this type opens a handover (cases, assets, checklist) for HR to complete.
  requiresHandover    Boolean           @default(false)
  isActive            Boolean           @default(true)
  sortOrder           Int               @default(0)
  requests            LeaveRequest[]
  adjustments         LeaveAdjustment[]
}

/// Manual change to a leave balance: opening balance, correction or encashment (negative).
model LeaveAdjustment {
  id          String    @id @default(uuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  year        Int
  days        Decimal   @db.Decimal(6, 2)
  reason      String
  createdById String
  createdAt   DateTime  @default(now())

  @@index([employeeId, leaveTypeId, year])
}

/// Company-wide payroll and attendance rules (single row, id "default"), edited in HR settings.
model HrPolicy {
  visaExemptCountries String[] @default([])
  id                  String   @id @default("default")
  /// "arrears": pay day falls in the next month and pays the previous month; "current": pay day is inside the month.
  salaryTiming        String   @default("arrears")
  payDay              Int      @default(1)
  /// Last day of the month counted for attendance in "current" timing; later days roll into next month's payroll.
  attendanceCutoffDay Int?
  weekendDays         Int[]    @default([5, 6])
  workdayHours        Decimal  @default(8) @db.Decimal(4, 2)
  workdayStart        String   @default("08:00")
  /// Divisor for the daily rate: "30", "calendar_days" or "working_days".
  dailyRateBasis      String   @default("30")
  /// Pay used for absence and leave deductions: "basic" or "fixed" (basic + fixed allowances).
  deductionBase       String   @default("fixed")
  overtimeBase        String   @default("basic")
  overtimeRate        Decimal  @default(1.25) @db.Decimal(4, 2)
  overtimeNightRate   Decimal  @default(1.50) @db.Decimal(4, 2)
  overtimeRestDayRate Decimal  @default(1.50) @db.Decimal(4, 2)
  overtimeHolidayRate Decimal  @default(2.00) @db.Decimal(4, 2)
  lateGraceMinutes    Int      @default(15)
  deductLateness      Boolean  @default(false)
  /// How a working day with no attendance record counts: "present" or "absent".
  unmarkedDays        String   @default("present")
  prorateJoiners      Boolean  @default(true)
  commissionInPayroll Boolean  @default(true)
  /// Leaving indemnity for staff outside the configured pension end-of-service scheme (see GratuityRules in hr/final-settlement.ts).
  gratuityRules       Json     @default("{\"enabled\": false, \"appliesTo\": [], \"wageBasis\": \"basic\", \"firstYears\": 3, \"firstYearsMonths\": 0.5, \"laterYearsMonths\": 1, \"minServiceMonths\": 0, \"serviceUntil\": null}")
  /// Pay used for the daily rate of unused annual leave paid out on leaving: "basic" or "fixed".
  leaveEncashmentBase String   @default("fixed")
  updatedById         String?
  updatedAt           DateTime @updatedAt
}

model PublicHoliday {
  id     String   @id @default(uuid())
  date   DateTime @unique @db.Date
  nameEn String
  nameAr String
}

/// Shift kinds that carry an allowance per shift worked (e.g. night shift, on-location day).
model ShiftType {
  id             String            @id @default(uuid())
  code           String            @unique
  nameEn         String
  nameAr         String
  /// "fixed" BHD per shift, or "percent" of the daily rate.
  allowanceMode  String            @default("fixed")
  allowanceValue Decimal           @default(0) @db.Decimal(13, 6)
  isActive       Boolean           @default(true)
  attendance     AttendanceEntry[]
}

model LeaveRequest {
  id            String    @id @default(uuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId   String
  leaveType     LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  startDate     DateTime
  endDate       DateTime
  fullDay       Boolean   @default(true)
  hours         Decimal?  @db.Decimal(4, 2)
  /// "full", "half_am", "half_pm" or "hours".
  dayPortion    String    @default("full")
  /// Days charged, worked out when the request is made (working or calendar days per the leave type).
  days          Decimal   @default(0) @db.Decimal(6, 2)
  attachmentUrl String?
  status        String    @default("pending") // "pending", "approved", "rejected", "cancelled"
  reason        String    @db.Text
  approvedById  String?
  approvedAt    DateTime?
  reviewNotes   String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([employeeId, status])
  @@index([startDate, endDate])
  @@index([createdAt])
  @@index([leaveTypeId])
}

model AttendanceEntry {
  id                     String     @id @default(uuid())
  employeeId             String
  employee               Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date                   DateTime   @db.Date
  checkIn                DateTime?
  checkOut               DateTime?
  status                 String     @default("present") // "present", "absent", "half_day", "on_leave", "holiday"
  lateMinutes            Int        @default(0)
  overtimeMinutes        Int        @default(0)
  overtimeNightMinutes   Int        @default(0)
  overtimeRestDayMinutes Int        @default(0)
  overtimeHolidayMinutes Int        @default(0)
  shiftTypeId            String?
  shiftType              ShiftType? @relation(fields: [shiftTypeId], references: [id], onDelete: SetNull)
  source                 String     @default("manual") // "manual", "bulk", "import"
  recordedById           String?
  notes                  String?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @default(now()) @updatedAt

  @@unique([employeeId, date])
  @@index([date])
  @@index([shiftTypeId])
}

model BenefitPlan {
  id                   String   @id @default(uuid())
  code                 String   @unique
  nameEn               String
  nameAr               String
  coverageDetails      String?  @db.Text
  employerContribution Decimal  @default(0.000) @db.Decimal(15, 6)
  employeeContribution Decimal  @default(0.000) @db.Decimal(15, 6)
  createdAt            DateTime @default(now())
}

model PayrollRun {
  id                String        @id @default(uuid())
  month             Int
  year              Int
  periodStart       DateTime      @db.Date
  periodEnd         DateTime      @db.Date
  /// Attendance, leave and commission are counted over this window (differs from the month with a cut-off day).
  attendanceStart   DateTime?     @db.Date
  attendanceEnd     DateTime?     @db.Date
  payDate           DateTime?     @db.Date
  status            String        @default("draft") // "draft", "calculated", "submitted", "approved", "paid", "closed"
  totalGross        Decimal       @default(0.000) @db.Decimal(15, 6)
  totalDeductions   Decimal       @default(0.000) @db.Decimal(15, 6)
  totalNet          Decimal       @default(0.000) @db.Decimal(15, 6)
  totalEmployerCost Decimal       @default(0.000) @db.Decimal(15, 6)
  approvedById      String?
  approvedAt        DateTime?
  paidAt            DateTime?
  items             PayrollItem[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([year, month])
}

model PayrollItem {
  id                  String            @id @default(uuid())
  payrollRunId        String
  payrollRun          PayrollRun        @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId          String
  employee            Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  basicSalary         Decimal           @default(0.000) @db.Decimal(15, 6)
  housingAllowance    Decimal           @default(0.000) @db.Decimal(15, 6)
  transportAllowance  Decimal           @default(0.000) @db.Decimal(15, 6)
  otherAllowances     Decimal           @default(0.000) @db.Decimal(15, 6)
  grossSalary         Decimal           @default(0.000) @db.Decimal(15, 6)
  gosiEmployee        Decimal           @default(0.000) @db.Decimal(15, 6)
  gosiEmployer        Decimal           @default(0.000) @db.Decimal(15, 6)
  externalSupport     Decimal           @default(0.000) @db.Decimal(15, 6)
  calculationSnapshot Json?
  otherDeductions     Decimal           @default(0.000) @db.Decimal(15, 6)
  /// One-off incentives and bonuses for the month (not subject to GOSI).
  bonus               Decimal           @default(0.000) @db.Decimal(15, 6)
  overtimePay         Decimal           @default(0.000) @db.Decimal(15, 6)
  shiftAllowance      Decimal           @default(0.000) @db.Decimal(15, 6)
  commission          Decimal           @default(0.000) @db.Decimal(15, 6)
  /// Absent days, half days and pay for days before joining.
  absenceDeduction    Decimal           @default(0.000) @db.Decimal(15, 6)
  /// Unpaid share of leave (unpaid and half-paid leave).
  leaveDeduction      Decimal           @default(0.000) @db.Decimal(15, 6)
  latenessDeduction   Decimal           @default(0.000) @db.Decimal(15, 6)
  /// Attendance and leave counts behind the figures, shown on the employee's payment page.
  attendanceSummary   Json?
  adjustmentNote      String?
  editedById          String?
  editedAt            DateTime?
  netSalary           Decimal           @default(0.000) @db.Decimal(15, 6)
  paymentStatus       String            @default("pending") // "pending", "paid"
  paidAt              DateTime?
  paidById            String?
  paymentMethod       String?
  paymentReference    String?
  payslip             Payslip?
  commissionPayout    CommissionPayout?
  /// Manual and recurring additions and deductions; bonus and otherDeductions hold their totals.
  lines               PayrollItemLine[]
  createdAt           DateTime          @default(now())

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
}

model Payslip {
  id            String      @id @default(uuid())
  payrollItemId String      @unique
  payrollItem   PayrollItem @relation(fields: [payrollItemId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  month         Int
  year          Int
  storagePath   String?
  issuedAt      DateTime    @default(now())

  @@index([employeeId, year, month])
}

model SalaryDocument {
  id            String    @id @default(uuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  kind          String // payslip, salary_certificate
  months        Json // YYYY-MM values
  /// Languages the employee asked for: ["ar"], ["en"] or both; each is its own PDF.
  languages     String[]  @default(["ar", "en"])
  status        String    @default("pending")
  requestedById String
  reviewedById  String?
  reviewNotes   String?
  snapshot      Json?
  createdAt     DateTime  @default(now())
  issuedAt      DateTime?
  updatedAt     DateTime  @updatedAt

  @@index([employeeId, createdAt])
  @@index([status])
}

/// A staff member's out-of-pocket spend: submitted → approved (policy) → scheduled by finance → paid.
/// Paying a claim records the matching Expense so it reaches the financials.
model ExpenseClaim {
  id               String           @id @default(uuid())
  claimNumber      String           @unique
  claimantId       String
  claimant         User             @relation("ExpenseClaimClaimant", fields: [claimantId], references: [id], onDelete: Restrict)
  amount           Decimal          @db.Decimal(15, 6)
  currency         String
  expenseDate      DateTime         @db.Date
  reason           String
  categoryId       String?
  category         ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  dealId           String?
  deal             CrmDeal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)
  invoiceId        String?
  invoice          Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  calendarEventId  String?
  calendarEvent    CalendarEvent?   @relation(fields: [calendarEventId], references: [id], onDelete: SetNull)
  receiptUrl       String
  /// submitted | approved | rejected | scheduled | paid | cancelled
  status           String           @default("submitted")
  reviewNotes      String?
  scheduledAt      DateTime?
  scheduledForDate DateTime?        @db.Date
  scheduledById    String?
  scheduledBy      User?            @relation("ExpenseClaimScheduler", fields: [scheduledById], references: [id], onDelete: SetNull)
  paidAt           DateTime?
  paidById         String?
  paidBy           User?            @relation("ExpenseClaimPayer", fields: [paidById], references: [id], onDelete: SetNull)
  paymentMethod    String?
  paymentReference String?
  expenseId        String?          @unique
  expense          Expense?         @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([claimantId])
  @@index([status])
  @@index([createdAt])
}

/// Who a quotation or invoice was credited to, and every reassignment (internal history).
model SalesAttributionChange {
  id          String   @id @default(uuid())
  entityType  String // "quotation" | "invoice"
  entityId    String
  fromUserId  String?
  fromUser    User?    @relation("AttributionFrom", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUserId    String
  toUser      User     @relation("AttributionTo", fields: [toUserId], references: [id], onDelete: Restrict)
  changedById String
  changedBy   User     @relation("AttributionChangedBy", fields: [changedById], references: [id], onDelete: Restrict)
  reason      String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
}

/// A month's commission paid to a salesperson; recording it books a payroll-type expense.
model CommissionPayout {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation("CommissionPayee", fields: [userId], references: [id], onDelete: Restrict)
  periodMonth   String // YYYY-MM
  basisAmount   Decimal      @db.Decimal(15, 6)
  ratePercent   Decimal      @db.Decimal(5, 2)
  amount        Decimal      @db.Decimal(15, 6)
  currency      String
  expenseId     String?      @unique
  expense       Expense?     @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  /// Set when the commission is paid with the salary instead of as a separate expense.
  payrollItemId String?      @unique
  payrollItem   PayrollItem? @relation(fields: [payrollItemId], references: [id], onDelete: Cascade)
  recordedById  String
  recordedBy    User         @relation("CommissionRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt     DateTime     @default(now())

  @@unique([userId, periodMonth])
}

/// Money received from a wage-support programme (e.g. Tamkeen) for one employee's six-month claim.
model SupportReimbursement {
  id             String   @id @default(uuid())
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  provider       String
  periodStart    String // YYYY-MM, first month of the claim
  periodEnd      String // YYYY-MM, last month of the claim
  claimedAmount  Decimal  @db.Decimal(15, 6)
  receivedAmount Decimal  @db.Decimal(15, 6)
  receivedOn     DateTime @db.Date
  reference      String?
  recordedById   String
  recordedBy     User     @relation("SupportReimbursementRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt      DateTime @default(now())

  @@unique([employeeId, provider, periodStart])
}

/// Account settings change filed from HR (role, manager, status, discount limit, commission); applied once approved.
model AccountChangeRequest {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation("AccountChangeTarget", fields: [userId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User      @relation("AccountChangeRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  /// Only the fields being changed: role, managerId, status, statusReason, discountLimitPercent, commissionRatePercent.
  changes       Json
  /// The same fields as they were when the request was filed.
  before        Json
  reason        String?
  /// pending | approved | rejected | cancelled
  status        String    @default("pending")
  decidedById   String?
  reviewNotes   String?
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([status])
}

/// A drawn signature waiting to replace a user's signature; applied only once approved. Kept as the change log.
model SignatureChange {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation("SignatureChangeOwner", fields: [userId], references: [id], onDelete: Cascade)
  signatureUrl String
  previousUrl  String?
  /// pending | approved | rejected | cancelled
  status       String    @default("pending")
  reviewedById String?
  reviewedBy   User?     @relation("SignatureChangeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNotes  String?
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([status])
}

/// A client's acceptance of a quotation or invoice: signed online through a time-limited link, or a
/// signed copy uploaded by staff. The token is stored only as a SHA-256 hash.
model ClientSignature {
  id              String    @id @default(uuid())
  /// quotation | invoice
  documentType    String
  documentId      String
  /// link | upload
  method          String
  /// pending (link not used yet) | signed | revoked | expired
  status          String    @default("pending")
  tokenHash       String?   @unique
  expiresAt       DateTime?
  recipientEmail  String?
  signerName      String?
  signerTitle     String?
  /// The drawn signature as a PNG data URL (signed online).
  signatureData   String?
  /// The uploaded signed copy (private file).
  signedFileUrl   String?
  /// The terms shown to the client when they accepted.
  termsText       String?
  termsAccepted   Boolean   @default(false)
  /// Fingerprint of the document's number, total and lines at the moment it was signed.
  documentHash    String?
  signedIp        String?
  signedUserAgent String?
  signedAt        DateTime?
  viewedAt        DateTime?
  revokedAt       DateTime?
  createdById     String
  createdBy       User      @relation("ClientSignatureCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime  @default(now())

  @@index([documentType, documentId])
  @@index([status])
}

/// A tax the company is registered for besides VAT (VAT lives on CompanySetting). Active taxes apply to new
/// invoices and quotations like VAT does, and their certificate is printed as a QR code on documents.
model TaxRate {
  id                    String        @id @default(uuid())
  /// Short stable identifier used in the certificate link, e.g. "tourism-levy".
  code                  String        @unique
  nameEn                String
  nameAr                String
  ratePercent           Decimal       @db.Decimal(5, 2)
  registrationNumber    String?
  certificateUrl        String?
  certificateValidUntil DateTime?     @db.Date
  appliesToInvoices     Boolean       @default(true)
  appliesToQuotations   Boolean       @default(true)
  isActive              Boolean       @default(true)
  displayOrder          Int           @default(0)
  documentTaxes         DocumentTax[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

/// The other taxes on one invoice or quotation, frozen when the document is calculated.
model DocumentTax {
  id                 String     @id @default(uuid())
  invoiceId          String?
  invoice            Invoice?   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  quotationId        String?
  quotation          Quotation? @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  taxRateId          String?
  taxRate            TaxRate?   @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  code               String
  nameEn             String
  nameAr             String
  ratePercent        Decimal    @db.Decimal(5, 2)
  registrationNumber String?
  amount             Decimal    @db.Decimal(15, 6)
  displayOrder       Int        @default(0)

  @@index([invoiceId])
  @@index([quotationId])
}

/// A visa, work or residence permit, licence, insurance or other document an employee holds, with its expiry
/// and what it costs the company (one-off, monthly, yearly or per term).
model EmployeeCredential {
  id             String    @id @default(uuid())
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// "visa", "work_permit", "residence_permit", "driving_license", "health_insurance", "medical_fitness", "professional_license", "other"
  kind           String
  /// Visas: "employment", "family", "investor", "flexi", "visit", "other"
  visaType       String?
  label          String?
  number         String?
  issuingCountry String?
  issueDate      DateTime? @db.Date
  expiryDate     DateTime? @db.Date
  sponsor        String?
  costAmount     Decimal?  @db.Decimal(15, 6)
  costCurrency   String    @default("BHD")
  /// "one_time" | "monthly" | "yearly" | "term"
  costFrequency  String?
  /// Months a "term" cost covers, e.g. 24 for a two-year permit.
  costTermMonths Int?
  /// "company" | "employee"
  paidBy         String    @default("company")
  fileUrl        String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([employeeId])
  @@index([expiryDate])
}

/// One named addition or deduction on a month's salary, entered by payroll or carried from a recurring item.
model PayrollItemLine {
  id            String      @id @default(uuid())
  payrollItemId String
  payrollItem   PayrollItem @relation(fields: [payrollItemId], references: [id], onDelete: Cascade)
  /// "addition" | "deduction"
  kind          String
  category      String
  label         String
  amount        Decimal     @db.Decimal(15, 6)
  note          String?
  /// "manual" | "recurring"
  source        String      @default("manual")
  recurringId   String?
  displayOrder  Int         @default(0)
  createdById   String?
  createdAt     DateTime    @default(now())

  @@index([payrollItemId])
}

/// A custom addition or deduction paid every month between two months (e.g. phone allowance, loan repayment).
model EmployeeRecurringPay {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind       String
  category   String
  label      String
  amount     Decimal  @db.Decimal(15, 6)
  /// YYYY-MM, inclusive.
  startMonth String
  endMonth   String?
  isActive   Boolean  @default(true)
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([employeeId])
}

/// A periodic company cost (rent, electricity and water, phones, internet, subscriptions, insurance…).
/// Each due date either records the expense automatically or reminds finance to record the actual bill.
model RecurringExpense {
  id               String           @id @default(uuid())
  titleEn          String
  titleAr          String?
  categoryId       String?
  category         ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  vendorName       String?
  /// Account, contract or subscriber number with the vendor.
  reference        String?
  amount           Decimal          @db.Decimal(15, 6)
  inputVatAmount   Decimal          @default(0.000) @db.Decimal(15, 6)
  isVatRecoverable Boolean          @default(true)
  currency         String
  paymentMethod    String?
  /// "weekly" | "monthly" | "quarterly" | "semiannual" | "yearly"
  frequency        String
  startDate        DateTime         @db.Date
  endDate          DateTime?        @db.Date
  nextDueDate      DateTime         @db.Date
  /// true: recorded automatically on the due date; false: finance records the actual bill.
  autoRecord       Boolean          @default(false)
  remindDaysBefore Int              @default(3)
  isActive         Boolean          @default(true)
  notes            String?
  createdById      String?
  lastRecordedAt   DateTime?
  expenses         Expense[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([isActive, nextDueDate])
}

/// A kind of company asset (laptop, camera, lens, vehicle…) with its own spec fields and handover checklist.
model AssetCategory {
  id           String   @id @default(uuid())
  code         String   @unique
  nameEn       String
  nameAr       String
  /// [{ key, labelEn, labelAr, type: "text" | "number" | "date" | "boolean", required? }]
  specFields   Json     @default("[]")
  /// [{ key, labelEn, labelAr }] — what is checked at each handover.
  checklist    Json     @default("[]")
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  assets       Asset[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Company equipment and property issued to staff.
model Asset {
  id               String          @id @default(uuid())
  assetTag         String          @unique
  categoryId       String
  category         AssetCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name             String
  brand            String?
  model            String?
  serialNumber     String?
  purchaseDate     DateTime?       @db.Date
  purchaseCost     Decimal?        @db.Decimal(15, 6)
  currency         String
  supplier         String?
  invoiceReference String?
  warrantyUntil    DateTime?       @db.Date
  /// "new" | "excellent" | "good" | "fair" | "poor" | "damaged"
  condition        String          @default("good")
  /// "available" | "assigned" | "maintenance" | "lost" | "retired"
  status           String          @default("available")
  /// Values for the category's spec fields.
  specs            Json            @default("{}")
  location         String?
  holderEmployeeId String?
  holder           Employee?       @relation("AssetHolder", fields: [holderEmployeeId], references: [id], onDelete: SetNull)
  notes            String?
  createdById      String?
  handovers        AssetHandover[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([holderEmployeeId])
}

/// Issuing an asset to an employee or taking it back: condition, checklist, damage, the employee's signature,
/// then approval (line manager, HR, finance by default) before the asset changes hands.
model AssetHandover {
  id                  String    @id @default(uuid())
  reference           String    @unique
  assetId             String
  asset               Asset     @relation(fields: [assetId], references: [id], onDelete: Restrict)
  employeeId          String
  employee            Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  /// "issue" | "return"
  kind                String
  /// "awaiting_employee" | "pending_approval" | "completed" | "rejected" | "cancelled"
  status              String    @default("awaiting_employee")
  handoverDate        DateTime  @db.Date
  condition           String
  /// [{ key, labelEn, labelAr, ok, note }]
  checklist           Json      @default("[]")
  specsSnapshot       Json      @default("{}")
  accessories         String?
  damageNotes         String?
  /// Where a returned asset goes once the return is approved: available | maintenance | lost | retired.
  returnStatus        String?
  damageCharge        Decimal?  @db.Decimal(15, 6)
  /// A damage charge recovered from the next salary.
  deductFromSalary    Boolean   @default(false)
  notes               String?
  /// Set when the handover is part of an employee's exit or leave handover.
  offboardingId       String?
  createdById         String
  creatorSignatureUrl String?
  employeeSignature   String?
  employeeSignerName  String?
  employeeSignedAt    DateTime?
  signedInPerson      Boolean   @default(false)
  decidedAt           DateTime?
  decisionNotes       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([assetId])
  @@index([employeeId])
  @@index([status])
}

/// Handing over an employee's work, cases and company assets before they leave the company or go on a long leave.
model EmployeeHandover {
  id             String                 @id @default(uuid())
  reference      String                 @unique
  employeeId     String
  employee       Employee               @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  /// "exit" | "leave"
  kind           String
  leaveRequestId String?                @unique
  /// Last working day (exit) or first day of leave.
  effectiveDate  DateTime               @db.Date
  returnDate     DateTime?              @db.Date
  reason         String?
  /// "open" | "pending_approval" | "completed" | "rejected" | "cancelled"
  status         String                 @default("open")
  /// "delegate" (all to one person) | "spread" (round robin across a team) | "manual" (one by one)
  casesMode      String                 @default("manual")
  delegateUserId String?
  teamUserIds    String[]               @default([])
  /// [{ key, labelEn?, labelAr?, done, notApplicable, note, byId, at }]
  checklist      Json                   @default("[]")
  notes          String?
  createdById    String
  decidedAt      DateTime?
  decisionNotes  String?
  cases          EmployeeHandoverCase[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([employeeId])
  @@index([status])
}

/// One piece of work moved off the departing employee: a request, a deal or an approval waiting for them.
model EmployeeHandoverCase {
  id           String           @id @default(uuid())
  handoverId   String
  handover     EmployeeHandover @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  /// "request" | "deal" | "approval"
  caseType     String
  caseId       String
  label        String
  toUserId     String?
  /// "pending" | "reassigned" | "closed"
  status       String           @default("pending")
  reassignedAt DateTime?
  createdAt    DateTime         @default(now())

  @@unique([handoverId, caseType, caseId])
}

/// How a document is signed: "stored" applies the signer's approved saved signature, "live" requires drawing it
/// at the moment of signing or approving.
model SignaturePolicy {
  documentType String   @id
  mode         String   @default("stored")
  updatedById  String?
  updatedAt    DateTime @default(now()) @updatedAt
}

/// A one-time link someone opens to sign a document on their own device (e.g. an employee receiving an asset).
/// The token is stored only as a SHA-256 hash.
model SignatureRequest {
  id              String    @id @default(uuid())
  /// "asset_handover"
  documentType    String
  documentId      String
  tokenHash       String    @unique
  /// pending | signed | revoked | expired
  status          String    @default("pending")
  expiresAt       DateTime
  recipientEmail  String?
  recipientPhone  String?
  signerName      String?
  signatureData   String?
  signedAt        DateTime?
  signedIp        String?
  signedUserAgent String?
  viewedAt        DateTime?
  revokedAt       DateTime?
  createdById     String
  createdAt       DateTime  @default(now())

  @@index([documentType, documentId])
}

/// Company-wide social insurance rules (single row "default").
model GosiSettings {
  nationalityCategories Json @default("{}")
  id               String   @id @default("default")
  /// Due in full for a month the employee is employed on its 1st day; not due for a month joined after the 1st.
  firstOfMonthRule Boolean  @default(true)
  /// "contract" pay, or the wage "registered" with the pension fund when an employee has one.
  wageSource       String   @default("registered")
  updatedById      String?
  updatedAt        DateTime @default(now()) @updatedAt
}

/// One social insurance contribution (pension, unemployment, occupational hazards…) in force between two dates.
/// A rate change is a new row for the same code from its effective date; history is never edited away.
model GosiComponent {
  id              String    @id @default(uuid())
  code            String
  nameEn          String
  nameAr          String
  /// Insured categories it applies to: "bahraini", "gcc", "expat".
  appliesTo       String[]  @default([])
  employeePercent Decimal   @default(0) @db.Decimal(9, 6)
  employerPercent Decimal   @default(0) @db.Decimal(9, 6)
  /// Rates by completed years of service: [{ fromYears, employeePercent, employerPercent }].
  serviceTiers    Json      @default("[]")
  /// "basic" | "basic_housing" | "fixed" (basic + all fixed allowances)
  wageBasis       String    @default("fixed")
  minWage         Decimal?  @db.Decimal(15, 6)
  maxWage         Decimal?  @db.Decimal(15, 6)
  effectiveFrom   DateTime  @db.Date
  effectiveTo     DateTime? @db.Date
  isActive        Boolean   @default(true)
  notes           String?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  @@index([code, effectiveFrom])
}

/// An employee's social insurance registration from a date: category, GOSI number, registered wage and
/// per-component exceptions. A change is a new record from its effective date.
model EmployeeGosiRecord {
  id                 String    @id @default(uuid())
  employeeId         String
  employee           Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// "bahraini" | "gcc" | "expat" | "exempt"
  category           String
  registrationNumber String?
  registeredWage     Decimal?  @db.Decimal(15, 6)
  /// [{ code, employeePercent?, employerPercent?, exempt? }]
  overrides          Json      @default("[]")
  effectiveFrom      DateTime  @db.Date
  effectiveTo        DateTime? @db.Date
  notes              String?
  createdById        String?
  createdAt          DateTime  @default(now())

  @@index([employeeId, effectiveFrom])
}

/// A wage-support programme (e.g. Tamkeen) whose terms are kept as dated rules.
model SupportProgram {
  id                String               @id @default(uuid())
  code              String               @unique
  nameEn            String
  nameAr            String
  provider          String
  claimPeriodMonths Int                  @default(6)
  prorate           Boolean              @default(true)
  isActive          Boolean              @default(true)
  notes             String?
  rules             SupportProgramRule[]
  enrolments        EmployeeSupport[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @default(now()) @updatedAt
}

/// The programme's terms from a date: share of the wage by year of support, wage and monthly caps.
model SupportProgramRule {
  id                String         @id @default(uuid())
  programId         String
  program           SupportProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  effectiveFrom     DateTime       @db.Date
  effectiveTo       DateTime?      @db.Date
  wageBasis         String         @default("fixed")
  /// [{ year, percent }]
  schedule          Json           @default("[]")
  wageCap           Decimal?       @db.Decimal(15, 6)
  monthlyCap        Decimal?       @db.Decimal(15, 6)
  /// [{ qualification, cap }]
  qualificationCaps Json           @default("[]")
  notes             String?
  createdById       String?
  createdAt         DateTime       @default(now())

  @@index([programId, effectiveFrom])
}

/// An employee's application to and support from a programme, with its decision and any partial approval.
model EmployeeSupport {
  id              String                 @id @default(uuid())
  employeeId      String
  employee        Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  programId       String
  program         SupportProgram         @relation(fields: [programId], references: [id], onDelete: Restrict)
  /// applied | approved | partially_approved | rejected | suspended | ended
  status          String                 @default("applied")
  qualification   String?
  applicationRef  String?
  appliedOn       DateTime?              @db.Date
  decidedOn       DateTime?              @db.Date
  /// YYYY-MM
  startMonth      String
  endMonth        String?
  approvedPercent Decimal?               @db.Decimal(5, 2)
  approvedAmount  Decimal?               @db.Decimal(15, 6)
  monthlyCap      Decimal?               @db.Decimal(15, 6)
  notes           String?
  createdById     String?
  events          EmployeeSupportEvent[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @default(now()) @updatedAt

  @@index([employeeId])
  @@index([programId, status])
}

/// Every change to an enrolment: applied, decided, partially approved, suspended, ended, edited.
model EmployeeSupportEvent {
  id        String          @id @default(uuid())
  supportId String
  support   EmployeeSupport @relation(fields: [supportId], references: [id], onDelete: Cascade)
  action    String
  details   Json?
  actorId   String?
  createdAt DateTime        @default(now())

  @@index([supportId, createdAt])
}

/// Everything owed to and by an employee who leaves: final salary, commission, unused leave, claims, indemnity,
/// loans and charges, social insurance for the last month. Approved, signed and paid like payroll.
model FinalSettlement {
  id                    String                @id @default(uuid())
  reference             String                @unique
  employeeId            String
  employee              Employee              @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  handoverId            String?
  /// resignation | termination | end_of_contract | retirement | death | other
  reason                String
  lastWorkingDay        DateTime              @db.Date
  /// draft | submitted | approved | rejected | paid | cancelled
  status                String                @default("draft")
  currency              String
  totalAdditions        Decimal               @default(0) @db.Decimal(15, 6)
  totalDeductions       Decimal               @default(0) @db.Decimal(15, 6)
  netAmount             Decimal               @default(0) @db.Decimal(15, 6)
  employerContributions Decimal               @default(0) @db.Decimal(15, 6)
  calculation           Json                  @default("{}")
  notes                 String?
  createdById           String
  calculatedAt          DateTime?
  approvedAt            DateTime?
  paidAt                DateTime?
  paidById              String?
  paymentMethod         String?
  paymentReference      String?
  employeeSignature     String?
  employeeSignerName    String?
  employeeSignedAt      DateTime?
  lines                 FinalSettlementLine[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @default(now()) @updatedAt

  @@index([employeeId])
  @@index([status])
}

model FinalSettlementLine {
  id           String          @id @default(uuid())
  settlementId String
  settlement   FinalSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  /// "addition" | "deduction"
  kind         String
  category     String
  labelEn      String
  labelAr      String
  amount       Decimal         @db.Decimal(15, 6)
  /// "auto" lines are recalculated; "manual" lines are kept.
  source       String          @default("auto")
  details      Json?
  displayOrder Int             @default(0)

  @@index([settlementId])
}

/// A personal calendar subscription link (Google Calendar, Outlook, Apple): lists only what the user may see.
model CalendarFeedToken {
  id         String    @id @default(uuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  layers     String[]  @default([])
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
}

/// Who may announce beyond the permission (single row "default").
model CommunicationSettings {
  id                     String   @id @default("default")
  /// Reporting managers may post announcements to their own team.
  managersAnnounceToTeam Boolean  @default(true)
  updatedById            String?
  updatedAt              DateTime @default(now()) @updatedAt
}

/// An announcement to the company, a team, departments, roles or people. Official ones are also issued as a
/// signed and stamped document on the letterhead once approved.
model Announcement {
  id                      String                @id @default(uuid())
  reference               String                @unique
  titleEn                 String
  titleAr                 String
  bodyEn                  String
  bodyAr                  String
  category                String                @default("general")
  priority                String                @default("normal")
  /// company | team | departments | roles | people
  audience                String                @default("company")
  audienceDepartmentIds   String[]              @default([])
  audienceRoles           String[]              @default([])
  audienceUserIds         String[]              @default([])
  official                Boolean               @default(false)
  requiresAcknowledgement Boolean               @default(false)
  pinned                  Boolean               @default(false)
  /// draft | pending_approval | published | rejected | archived
  status                  String                @default("draft")
  publishAt               DateTime?
  expiresAt               DateTime?
  publishedAt             DateTime?
  createdById             String
  signedById              String?
  signatureUrl            String?
  signedAt                DateTime?
  decisionNotes           String?
  receipts                AnnouncementReceipt[]
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @default(now()) @updatedAt

  @@index([status, publishedAt])
}

/// One person's copy of an announcement: read, acknowledged, hidden.
model AnnouncementReceipt {
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime?
  acknowledgedAt DateTime?
  hiddenAt       DateTime?

  @@id([announcementId, userId])
  @@index([userId])
}

/// A reusable official letter with {{placeholders}} filled from the company, the recipient and an employee.
model LetterTemplate {
  id            String           @id @default(uuid())
  key           String           @unique
  nameEn        String
  nameAr        String
  subjectEn     String           @default("")
  subjectAr     String           @default("")
  bodyEn        String           @default("")
  bodyAr        String           @default("")
  aboutEmployee Boolean          @default(false)
  isActive      Boolean          @default(true)
  displayOrder  Int              @default(0)
  letters       OfficialLetter[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @default(now()) @updatedAt
}

/// An official letter for external use on the letterhead, approved, signed and stamped, with a verification code.
model OfficialLetter {
  id                    String          @id @default(uuid())
  reference             String          @unique
  templateId            String?
  template              LetterTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  employeeId            String?
  employee              Employee?       @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  languages             String[]        @default(["ar", "en"])
  recipientName         String?
  recipientTitle        String?
  recipientOrganization String?
  recipientAddress      String?
  subjectEn             String          @default("")
  subjectAr             String          @default("")
  bodyEn                String          @default("")
  bodyAr                String          @default("")
  letterDate            DateTime        @db.Date
  /// confidential | internal | external
  classification        String          @default("external")
  showSignature         Boolean         @default(true)
  showStamp             Boolean         @default(true)
  /// draft | pending_approval | approved | rejected | cancelled
  status                String          @default("draft")
  createdById           String
  signerId              String?
  signatureUrl          String?
  signedAt              DateTime?
  verificationCode      String          @unique
  decisionNotes         String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @default(now()) @updatedAt

  @@index([status])
}

/// Product categories, nested (Products → Categories).
model ProductCategory {
  id        String            @id @default(uuid())
  nameEn    String
  nameAr    String
  parentId  String?
  parent    ProductCategory?  @relation("ProductCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  ProductCategory[] @relation("ProductCategoryTree")
  sortOrder Int               @default(0)
  isActive  Boolean           @default(true)
  products  Product[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([parentId])
}

/// Something the company sells or buys and keeps in stock. Prices are in the company currency.
model Product {
  packagingUnits ProductPackagingUnit[]
  stockSerials StockSerial[]
  serialGenerations SerialGeneration[]
  id              String           @id @default(uuid())
  sku             String           @unique
  barcode         String?          @unique
  nameEn          String
  nameAr          String
  descriptionEn   String?          @db.Text
  descriptionAr   String?          @db.Text
  categoryId      String?
  category        ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand           String?
  /// piece | box | pack | kg | g | l | ml | m | hour | service
  unit            String           @default("piece")
  cost            Decimal          @default(0) @db.Decimal(15, 6)
  price           Decimal          @default(0) @db.Decimal(15, 6)
  /// VAT is charged at the company rate unless the product is exempt.
  vatExempt       Boolean          @default(false)
  imageUrls       String[]         @default([])
  /// Up to three options with their values: [{ nameEn, nameAr, values: [{ en, ar }] }].
  options         Json             @default("[]")
  /// Services and digital items are sold without stock.
  trackStock      Boolean          @default(true)
  /// Stock is kept per batch with an expiry date (medicines, food).
  trackBatches    Boolean          @default(false)
  isActive        Boolean          @default(true)
  /// The website catalogue item showing this product.
  catalogueItemId String?          @unique
  catalogueItem   PortfolioItem?   @relation(fields: [catalogueItemId], references: [id], onDelete: SetNull)
  variants        ProductVariant[]
  createdById     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([categoryId])
  @@index([isActive, nameEn])
}

/// One combination of a product's options (size M, red). Without a price or cost it uses the product's.
model ProductVariant {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku          String   @unique
  barcode      String?  @unique
  /// The English value of each option, in the product's option order.
  optionValues String[] @default([])
  price        Decimal? @db.Decimal(15, 6)
  cost         Decimal? @db.Decimal(15, 6)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([productId])
}

/// A place stock is kept. Every warehouse has at least one location (its main one); shelves and bins are more.
model Warehouse {
  branchId       String?
  branch         Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)
  id             String          @id @default(uuid())
  code           String          @unique
  nameEn         String
  nameAr         String
  address        String?
  isActive       Boolean         @default(true)
  /// Where receipts and sales go unless another warehouse is chosen.
  isDefault      Boolean         @default(false)
  sortOrder      Int             @default(0)
  locations      StockLocation[]
  counts         StockCount[]
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model StockLocation {
  serials StockSerial[]
  packages StockPackage[]
  generations SerialGeneration[]
  id          String          @id @default(uuid())
  warehouseId String
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  /// Unique within the warehouse, e.g. MAIN, A-01, COLD.
  code        String
  name        String?
  isActive    Boolean         @default(true)
  levels      StockLevel[]
  movements   StockMovement[]
  allocationsFrom StockAllocation[] @relation("AllocationSource")
  allocationsInTransit StockAllocation[] @relation("AllocationTransit")
  allocationsTo StockAllocation[] @relation("AllocationDestination")
  createdAt   DateTime        @default(now())

  @@unique([warehouseId, code])
}

/// What one product (or one variant of it) has in stock across the company: its reorder point and average cost.
model StockItem {
  id              String    @id @default(uuid())
  productId       String
  /// The variant's id, or "" for a product without variants.
  variantKey      String    @default("")
  /// Weighted average unit cost of what is on hand, in the company currency.
  averageCost     Decimal   @default(0) @db.Decimal(14, 4)
  /// Alert when available stock falls to this; null for no alert.
  reorderPoint    Decimal?  @db.Decimal(17, 6)
  reorderQuantity Decimal?  @db.Decimal(17, 6)
  /// When the last low-stock alert went out, so one dip alerts once.
  lowAlertedAt    DateTime?
  updatedAt       DateTime  @updatedAt

  @@unique([productId, variantKey])
}

/// A batch of a batch-tracked product, with its expiry date.
model StockBatch {
  id          String    @id @default(uuid())
  productId   String
  variantKey  String    @default("")
  batchNumber String
  expiryDate  DateTime? @db.Date
  createdAt   DateTime  @default(now())

  @@unique([productId, variantKey, batchNumber])
  @@index([expiryDate])
}

/// The stock of one item at one location (and batch): kept in step with the movement ledger in the same transaction.
model StockLevel {
  id         String        @id @default(uuid())
  productId  String
  variantKey String        @default("")
  locationId String
  location   StockLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  /// The batch id, or "" when the product is not batch-tracked.
  batchKey   String        @default("")
  onHand     Decimal       @default(0) @db.Decimal(17, 6)
  /// Held for confirmed orders and not yet shipped.
  reserved   Decimal       @default(0) @db.Decimal(17, 6)
  updatedAt  DateTime      @updatedAt

  @@unique([productId, variantKey, locationId, batchKey])
  @@index([locationId])
}

/// The stock ledger: every change of stock is one row here and nothing else changes stock.
model StockMovement {
  id          String        @id @default(uuid())
  /// receipt | sale | return | transfer_out | transfer_in | adjustment | write_off | count
  type        String
  productId   String
  variantKey  String        @default("")
  locationId  String
  location    StockLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  batchKey    String        @default("")
  /// Signed: positive into the location, negative out of it.
  quantity    Decimal       @db.Decimal(17, 6)
  /// Unit cost in the company currency: what was paid for receipts, the average cost for everything else.
  unitCost    Decimal       @default(0) @db.Decimal(14, 4)
  /// What caused it, e.g. purchase_order, order, stock_count, transfer, manual.
  sourceType  String        @default("manual")
  sourceId    String?
  /// Both halves of a transfer share one id.
  transferId  String?
  /// adjustment and write-off reasons: damaged | expired | lost | found | correction | sample | other
  reason      String?
  note        String?
  createdById String?
  createdAt   DateTime      @default(now())

  @@index([productId, variantKey, createdAt])
  @@index([locationId, createdAt])
  @@index([sourceType, sourceId])
  @@index([createdAt])
}

/// A stock count: what was expected, what was counted, reviewed and approved into adjustments.
model StockCount {
  id           String           @id @default(uuid())
  number       String           @unique
  warehouseId  String
  warehouse    Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  /// full (everything in the warehouse) | cycle (chosen products or a category)
  scope        String           @default("full")
  /// counting | review | approved | cancelled
  status       String           @default("counting")
  note         String?
  createdById  String?
  submittedAt  DateTime?
  approvedById String?
  approvedAt   DateTime?
  lines        StockCountLine[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status])
}

model StockCountLine {
  id         String     @id @default(uuid())
  countId    String
  count      StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  productId  String
  variantKey String     @default("")
  locationId String
  batchKey   String     @default("")
  /// On hand when the count started.
  expected   Decimal    @db.Decimal(17, 6)
  /// Empty until counted.
  counted    Decimal?   @db.Decimal(17, 6)
  note       String?

  @@unique([countId, productId, variantKey, locationId, batchKey])
}

/// Someone asks to buy: lines with estimated costs, approved through the approval engine before ordering.
model PurchaseRequisition {
  id             String                    @id @default(uuid())
  number         String                    @unique
  requestedById  String
  departmentId   String?
  /// draft | pending_approval | approved | rejected | ordered | cancelled
  status         String                    @default("draft")
  neededBy       DateTime?                 @db.Date
  note           String?
  decisionNote   String?
  estimatedTotal Decimal                   @default(0) @db.Decimal(15, 6)
  lines          PurchaseRequisitionLine[]
  rfqs           Rfq[]
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([status])
  @@index([requestedById])
}

model PurchaseRequisitionLine {
  id                String              @id @default(uuid())
  requisitionId     String
  requisition       PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  /// A catalogue product (and variant), or empty for something described in words.
  productId         String?
  variantKey        String              @default("")
  description       String
  quantity          Decimal             @db.Decimal(17, 6)
  estimatedUnitCost Decimal?            @db.Decimal(15, 6)
  sortOrder         Int                 @default(0)
}

/// A request for quotation: the same lines sent to several suppliers, whose prices are compared side by side.
model Rfq {
  id             String               @id @default(uuid())
  number         String               @unique
  requisitionId  String?
  requisition    PurchaseRequisition? @relation(fields: [requisitionId], references: [id], onDelete: SetNull)
  title          String
  /// open | awarded | cancelled
  status         String               @default("open")
  dueDate        DateTime?            @db.Date
  note           String?
  createdById    String?
  lines          RfqLine[]
  quotes         RfqQuote[]
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

model RfqLine {
  id          String     @id @default(uuid())
  rfqId       String
  rfq         Rfq        @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  productId   String?
  variantKey  String     @default("")
  description String
  quantity    Decimal    @db.Decimal(17, 6)
  sortOrder   Int        @default(0)
  quotes      RfqQuote[]
}

/// One supplier's price for one line of a request for quotation.
model RfqQuote {
  id           String     @id @default(uuid())
  rfqId        String
  rfq          Rfq        @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  lineId       String
  line         RfqLine    @relation(fields: [lineId], references: [id], onDelete: Cascade)
  supplierId   String
  supplier     CrmContact @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  unitPrice    Decimal    @db.Decimal(12, 4)
  leadTimeDays Int?
  note         String?
  /// The price chosen for the purchase order.
  selected     Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@unique([rfqId, lineId, supplierId])
}

/// An order to a supplier. Amounts are in the company currency.
model PurchaseOrder {
  id            String               @id @default(uuid())
  number        String               @unique
  supplierId    String
  supplier      CrmContact           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  /// draft | pending_approval | approved | sent | partially_received | received | closed | cancelled
  status        String               @default("draft")
  orderDate     DateTime             @default(now()) @db.Date
  expectedDate  DateTime?            @db.Date
  /// Where the goods are delivered.
  warehouseId   String?
  warehouse     Warehouse?           @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  requisitionId String?
  requisition   PurchaseRequisition? @relation(fields: [requisitionId], references: [id], onDelete: SetNull)
  rfqId         String?
  rfq           Rfq?                 @relation(fields: [rfqId], references: [id], onDelete: SetNull)
  note          String?
  terms         String?
  vatEnabled    Boolean              @default(false)
  vatPercentage Decimal              @default(0) @db.Decimal(5, 2)
  subtotal      Decimal              @default(0) @db.Decimal(15, 6)
  vatAmount     Decimal              @default(0) @db.Decimal(15, 6)
  total         Decimal              @default(0) @db.Decimal(15, 6)
  sentAt        DateTime?
  /// email | whatsapp | printed
  sentVia       String?
  createdById   String?
  approvedById  String?
  approvedAt    DateTime?
  lines         PurchaseOrderLine[]
  receipts      GoodsReceipt[]
  bills         SupplierBill[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([supplierId])
  @@index([status])
  @@index([orderDate])
}

model PurchaseOrderLine {
  id               String             @id @default(uuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId        String?
  variantKey       String             @default("")
  description      String
  quantity         Decimal            @db.Decimal(17, 6)
  unitPrice        Decimal            @db.Decimal(12, 4)
  /// Accepted into stock so far (rejected items are not counted here).
  receivedQuantity Decimal            @default(0) @db.Decimal(17, 6)
  rejectedQuantity Decimal            @default(0) @db.Decimal(17, 6)
  billedQuantity   Decimal            @default(0) @db.Decimal(17, 6)
  sortOrder        Int                @default(0)
  receiptLines     GoodsReceiptLine[]
  billLines        SupplierBillLine[]
}

/// Goods arriving against a purchase order (all or part of it); accepted items enter stock as receipts.
model GoodsReceipt {
  id              String             @id @default(uuid())
  number          String             @unique
  purchaseOrderId String
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  locationId      String
  receivedById    String?
  receivedAt      DateTime           @default(now())
  note            String?
  lines           GoodsReceiptLine[]
  createdAt       DateTime           @default(now())
}

model GoodsReceiptLine {
  id               String            @id @default(uuid())
  receiptId        String
  receipt          GoodsReceipt      @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  orderLineId      String
  orderLine        PurchaseOrderLine @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  quantity         Decimal           @db.Decimal(17, 6)
  rejectedQuantity Decimal           @default(0) @db.Decimal(17, 6)
  rejectReason     String?
  batchNumber      String?
  expiryDate       DateTime?         @db.Date
}

/// The supplier's invoice: matched against what was ordered and received, approved into an expense, then paid.
model SupplierBill {
  id              String             @id @default(uuid())
  /// Our reference, e.g. BILL-2026-000001.
  number          String             @unique
  /// The supplier's own invoice number.
  supplierRef     String?
  supplierId      String
  supplier        CrmContact         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  billDate        DateTime           @db.Date
  dueDate         DateTime?          @db.Date
  /// draft | approved | partially_paid | paid | cancelled
  status          String             @default("draft")
  subtotal        Decimal            @default(0) @db.Decimal(15, 6)
  vatAmount       Decimal            @default(0) @db.Decimal(15, 6)
  total           Decimal            @default(0) @db.Decimal(15, 6)
  amountPaid      Decimal            @default(0) @db.Decimal(15, 6)
  /// The expense recorded when the bill is approved.
  expenseId       String?            @unique
  /// Approved although the three-way match found differences, with the reason.
  overrideReason  String?
  attachmentUrl   String?
  note            String?
  createdById     String?
  approvedById    String?
  approvedAt      DateTime?
  lines           SupplierBillLine[]
  payments        SupplierPayment[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([supplierId, supplierRef])
  @@index([supplierId])
  @@index([status])
}

model SupplierBillLine {
  id          String             @id @default(uuid())
  billId      String
  bill        SupplierBill       @relation(fields: [billId], references: [id], onDelete: Cascade)
  orderLineId String?
  orderLine   PurchaseOrderLine? @relation(fields: [orderLineId], references: [id], onDelete: SetNull)
  description String
  quantity    Decimal            @db.Decimal(17, 6)
  unitPrice   Decimal            @db.Decimal(12, 4)
  sortOrder   Int                @default(0)
}

model SupplierPayment {
  id          String       @id @default(uuid())
  billId      String
  bill        SupplierBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  amount      Decimal      @db.Decimal(15, 6)
  paidOn      DateTime     @db.Date
  /// bank_transfer | cash | cheque | card | other
  method      String
  reference   String?
  createdById String?
  createdAt   DateTime     @default(now())
}

/// Someone who buys on the website. Separate from staff users: customers never reach the admin.
model Customer {
  id              String            @id @default(uuid())
  /// Lower-case; unique among accounts that are not deleted.
  email           String            @unique
  name            String
  phone           String?
  /// bcrypt; empty for accounts that only use e-mailed codes or Google / Apple.
  passwordHash    String?
  emailVerifiedAt DateTime?
  /// en | ar: the language of e-mails to this customer.
  locale          String            @default("ar")
  googleSub       String?           @unique
  appleSub        String?           @unique
  marketingOptIn  Boolean           @default(false)
  /// The CRM contact for this customer (created or matched by e-mail at sign-up).
  crmContactId    String?           @unique
  crmContact      CrmContact?       @relation(fields: [crmContactId], references: [id], onDelete: SetNull)
  sessions        CustomerSession[]
  addresses       CustomerAddress[]
  wishlist        WishlistItem[]
  orders          SalesOrder[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model CustomerSession {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// SHA-256 of the cookie token; the token itself is never stored.
  tokenHash  String   @unique
  expiresAt  DateTime
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([customerId])
}

model CustomerAddress {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String?
  name       String
  phone      String
  line1      String
  line2      String?
  area       String?
  city       String
  country    String
  postalCode String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([customerId])
}

/// A one-time sign-in code sent by e-mail (stored hashed, a few attempts, ten minutes).
model CustomerAuthCode {
  id        String    @id @default(uuid())
  email     String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}

model WishlistItem {
  id              String        @id @default(uuid())
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  catalogueItemId String
  catalogueItem   PortfolioItem @relation(fields: [catalogueItemId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@unique([customerId, catalogueItemId])
}

/// How the online store sells: guest checkout, delivery fee, pickup and the payment methods offered.
model StoreSettings {
  id                  String   @id @default("default")
  guestCheckout       Boolean  @default(true)
  deliveryEnabled     Boolean  @default(true)
  deliveryFee         Decimal  @default(0) @db.Decimal(15, 6)
  /// Delivery is free from this order subtotal; null for never.
  freeDeliveryOver    Decimal? @db.Decimal(15, 6)
  pickupEnabled       Boolean  @default(false)
  codEnabled          Boolean  @default(true)
  bankTransferEnabled Boolean  @default(false)
  bankInstructionsEn  String?
  bankInstructionsAr  String?
  /// Where new-order alerts go (besides the people who can see orders).
  orderNotifyEmail    String?
  /// The payment gateway behind "Pay online" (an active payments integration), or null for no online payment.
  paymentGateway      String?
  updatedAt           DateTime @updatedAt
}

/// One try at paying an order online: the gateway's session, and what came of it.
model PaymentAttempt {
  id               String     @id @default(uuid())
  orderId          String
  order            SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gateway          String
  /// The gateway's checkout session, charge or order id.
  sessionId        String?
  /// The gateway's id for the captured payment (refunds use it).
  gatewayPaymentId String?
  amount           Decimal    @db.Decimal(15, 6)
  currency         String
  /// created | pending | paid | failed | expired | review
  status           String     @default("created")
  testMode         Boolean    @default(false)
  /// The receipt recorded when it was paid.
  paymentId        String?
  amountRefunded   Decimal    @default(0) @db.Decimal(15, 6)
  failureReason    String?
  createdAt        DateTime   @default(now())
  paidAt           DateTime?
  updatedAt        DateTime   @updatedAt

  @@unique([gateway, sessionId])
  @@unique([gateway, gatewayPaymentId])
  @@index([orderId])
  @@index([status, createdAt])
}

/// Webhooks already handled, so a gateway's retries change nothing twice.
model PaymentWebhookEvent {
  gateway    String
  eventId    String
  attemptId  String?
  receivedAt DateTime @default(now())

  @@id([gateway, eventId])
}

model Coupon {
  id        String    @id @default(uuid())
  /// Upper-case, unique.
  code      String    @unique
  /// percent | fixed
  kind      String
  value     Decimal   @db.Decimal(15, 6)
  minOrder  Decimal?  @db.Decimal(15, 6)
  startsAt  DateTime?
  endsAt    DateTime?
  maxUses   Int?
  usedCount Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
}

/// An order from the website, by phone or WhatsApp, or at the counter. Amounts are in the company currency.
model SalesOrder {
  id              String            @id @default(uuid())
  number          String            @unique
  customerId      String?
  customer        Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// The CRM contact the order (and its invoice) belongs to.
  contactId       String?
  email           String?
  name            String
  phone           String?
  /// website | phone | whatsapp | pos
  channel         String            @default("website")
  /// placed | paid | packing | shipped | delivered | cancelled | returned
  status          String            @default("placed")
  /// unpaid | pending | paid | partially_refunded | refunded
  paymentStatus   String            @default("unpaid")
  /// cod | bank_transfer | pay_later | cash | card | online
  paymentMethod   String
  /// delivery | pickup
  fulfilment      String            @default("delivery")
  shippingAddress Json?
  subtotal        Decimal           @db.Decimal(15, 6)
  discountAmount  Decimal           @default(0) @db.Decimal(15, 6)
  couponCode      String?
  vatAmount       Decimal           @default(0) @db.Decimal(15, 6)
  deliveryFee     Decimal           @default(0) @db.Decimal(15, 6)
  total           Decimal           @db.Decimal(15, 6)
  amountPaid      Decimal           @default(0) @db.Decimal(15, 6)
  amountRefunded  Decimal           @default(0) @db.Decimal(15, 6)
  currency        String
  /// en | ar: the language of messages about this order.
  locale          String            @default("ar")
  note            String?
  /// Stock is reserved at this warehouse and leaves it when shipped.
  warehouseId     String?
  invoiceId       String?           @unique
  createdById     String?
  placedAt        DateTime          @default(now())
  paidAt          DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  lines           SalesOrderLine[]
  events          SalesOrderEvent[]
  paymentAttempts PaymentAttempt[]
  shipments       Shipment[]
  inquiries       Inquiry[]
  /// Where the customer came from (utm_campaign, utm_source, utm_medium), when known.
  utmCampaign     String?
  utmSource       String?
  utmMedium       String?
  updatedAt       DateTime          @updatedAt

  @@index([status])
  @@index([customerId])
  @@index([placedAt])
  @@index([contactId])
  @@index([warehouseId])
}

model SalesOrderLine {
  id               String     @id @default(uuid())
  orderId          String
  order            SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  variantKey       String     @default("")
  sku              String
  description      String
  quantity         Decimal    @db.Decimal(17, 6)
  unitPrice        Decimal    @db.Decimal(15, 6)
  vatExempt        Boolean    @default(false)
  lineTotal        Decimal    @db.Decimal(15, 6)
  /// Where the stock is held for this line (none for products without stock).
  locationId       String?
  returnedQuantity Decimal    @default(0) @db.Decimal(17, 6)
  sortOrder        Int        @default(0)
}

/// The history of an order: each status change, payment, refund or note, with who did it.
model SalesOrderEvent {
  id        String     @id @default(uuid())
  orderId   String
  order     SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// status | payment | refund | note | email
  kind      String
  status    String?
  note      String?
  amount    Decimal?   @db.Decimal(15, 6)
  byId      String?
  createdAt DateTime   @default(now())

  @@index([orderId, createdAt])
}

/// How the company delivers: its own drivers, courier agencies or both, the delivery promise and slot rules.
model DeliverySettings {
  id          String   @id @default("default")
  /// own | agency | both
  mode        String   @default("own")
  /// Hours from ordering to delivery when no time slot is chosen.
  slaHours    Int      @default(48)
  /// IANA time zone for slot times; null uses the company country's.
  timeZone    String?
  /// How many days ahead customers can choose a slot.
  slotDays    Int      @default(7)
  /// Minutes between ordering and the start of the earliest slot.
  leadMinutes Int      @default(120)
  /// Customers must pick a slot when the zone has slots.
  requireSlot Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

/// An area served at its own fee, minimum order and free-delivery threshold.
model DeliveryZone {
  id        String         @id @default(uuid())
  nameEn    String
  nameAr    String
  /// Areas or cities the zone covers (matched without case or spacing); empty covers everywhere else.
  areas     String[]       @default([])
  fee       Decimal        @default(0) @db.Decimal(15, 6)
  minOrder  Decimal?       @db.Decimal(15, 6)
  freeOver  Decimal?       @db.Decimal(15, 6)
  isActive  Boolean        @default(true)
  sortOrder Int            @default(0)
  slots     DeliverySlot[]
  shipments Shipment[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

/// A weekly delivery window, for one zone or (without a zone) every zone.
model DeliverySlot {
  id        String        @id @default(uuid())
  zoneId    String?
  zone      DeliveryZone? @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  /// 0 = Sunday … 6 = Saturday.
  weekday   Int
  /// "HH:MM", local to the delivery time zone.
  start     String
  end       String
  /// Shipments per date; null for no limit.
  capacity  Int?
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())

  @@index([weekday])
}

/// Goods on their way to a customer: where, when, who carries them and what happened.
model Shipment {
  id                      String          @id @default(uuid())
  /// DL-YYYY-NNNNNN
  number                  String          @unique
  orderId                 String
  order                   SalesOrder      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// pending | assigned | out_for_delivery | delivered | failed | returned | cancelled
  status                  String          @default("pending")
  /// own | agency
  method                  String          @default("own")
  zoneId                  String?
  zone                    DeliveryZone?   @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  slotId                  String?
  slotDate                DateTime?       @db.Date
  slotStart               String?
  slotEnd                 String?
  /// When it was promised: the slot's end, else the order time plus the delivery promise.
  promisedBy              DateTime
  recipientName           String
  recipientPhone          String
  address                 Json
  /// Cash to collect on delivery.
  codAmount               Decimal         @default(0) @db.Decimal(15, 6)
  codCollected            Decimal         @default(0) @db.Decimal(15, 6)
  /// Opens the customer's tracking page.
  trackingToken           String          @unique
  attempts                Int             @default(0)
  failureReason           String?
  outAt                   DateTime?
  deliveredAt             DateTime?
  /// The employee driving it (own fleet).
  driverId                String?
  driver                  Employee?       @relation("ShipmentDriver", fields: [driverId], references: [id], onDelete: SetNull)
  vehicleId               String?
  vehicle                 Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  routeSheetId            String?
  routeSheet              RouteSheet?     @relation(fields: [routeSheetId], references: [id], onDelete: SetNull)
  /// Stop number on the route sheet.
  routeStop               Int?
  /// Proof of delivery: a photo (a private file) and/or the recipient's drawn signature (PNG data URL).
  proofPhotoUrl           String?
  proofSignature          String?
  /// The cash handover that settled the cash collected on it.
  codSettlementId         String?
  codSettlement           CodSettlement?  @relation(fields: [codSettlementId], references: [id], onDelete: SetNull)
  /// Courier agency carrying it (method "agency").
  agencyId                String?
  agency                  CourierAgency?  @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  trackingNumber          String?
  /// pending | unknown | confirmed | review; unresolved bookings must be reconciled before another dispatch.
  /// The attempted carrier, separate from a confirmed agency assignment.
  courierBookingAgencyId  String?
  courierBookingStatus    String?
  courierBookingStartedAt DateTime?
  /// The agency's shipping label (a private file), when its API provides one.
  labelUrl                String?
  /// What the agency charges for it, for checking its invoice.
  agencyFee               Decimal?        @db.Decimal(15, 6)
  agencyInvoiceId         String?
  agencyInvoice           AgencyInvoice?  @relation(fields: [agencyInvoiceId], references: [id], onDelete: SetNull)
  /// When the agency's tracking was last read.
  trackedAt               DateTime?
  events                  ShipmentEvent[]
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@index([orderId])
  @@index([status, promisedBy])
  @@index([slotDate])
  @@index([driverId, status])
  @@index([routeSheetId])
  @@index([agencyId, status])
  @@index([zoneId])
  @@index([vehicleId])
}

model ShipmentEvent {
  id         String   @id @default(uuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status     String
  reason     String?
  note       String?
  byId       String?
  at         DateTime @default(now())

  @@index([shipmentId, at])
}

/// A company vehicle used for deliveries.
model Vehicle {
  id          String       @id @default(uuid())
  plate       String       @unique
  name        String
  /// car | van | motorbike | truck | bicycle | other
  kind        String       @default("van")
  notes       String?
  isActive    Boolean      @default(true)
  shipments   Shipment[]
  routeSheets RouteSheet[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

/// One driver's run on one day: the stops in order, with the vehicle.
model RouteSheet {
  id          String     @id @default(uuid())
  /// RS-YYYY-NNNNNN
  number      String     @unique
  date        DateTime   @db.Date
  driverId    String
  driver      Employee   @relation("RouteSheetDriver", fields: [driverId], references: [id], onDelete: Restrict)
  vehicleId   String?
  vehicle     Vehicle?   @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  /// draft | out | closed
  status      String     @default("draft")
  note        String?
  createdById String?
  shipments   Shipment[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([date, driverId])
}

/// A driver handing over the cash collected on deliveries.
model CodSettlement {
  id          String         @id @default(uuid())
  /// CS-YYYY-NNNNNN
  number      String         @unique
  /// Who handed the cash over: a driver, or a courier agency remitting what it collected.
  driverId    String?
  driver      Employee?      @relation("CodSettlementDriver", fields: [driverId], references: [id], onDelete: Restrict)
  agencyId    String?
  agency      CourierAgency? @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  expected    Decimal        @db.Decimal(15, 6)
  received    Decimal        @db.Decimal(15, 6)
  note        String?
  settledById String?
  settledAt   DateTime       @default(now())
  shipments   Shipment[]

  @@index([driverId, settledAt])
}

/// A courier company that delivers for the store: by hand-entered tracking numbers, or through its API.
model CourierAgency {
  id             String          @id @default(uuid())
  name           String
  /// manual | aramex | dhl_express | smsa
  kind           String          @default("manual")
  /// The public tracking page, with {tracking} where the number goes.
  trackingUrl    String?
  phone          String?
  email          String?
  /// Usual charge per shipment.
  feePerShipment Decimal?        @db.Decimal(15, 6)
  isActive       Boolean         @default(true)
  shipments      Shipment[]
  invoices       AgencyInvoice[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  CodSettlement  CodSettlement[]
}

/// An agency's bill for the shipments it carried, recorded as an expense.
model AgencyInvoice {
  id          String        @id @default(uuid())
  agencyId    String
  agency      CourierAgency @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  /// The agency's invoice number.
  reference   String
  invoiceDate DateTime      @db.Date
  amount      Decimal       @db.Decimal(15, 6)
  expenseId   String?       @unique
  createdById String?
  shipments   Shipment[]
  createdAt   DateTime      @default(now())

  @@unique([agencyId, reference])
}

/// A body of work with its own tasks: a launch, an event, a client job, an internal improvement.
model Project {
  id           String    @id @default(uuid())
  /// PRJ-YYYY-NNNNNN
  code         String    @unique
  name         String
  description  String?   @db.Text
  /// active | on_hold | done | archived
  status       String    @default("active")
  departmentId String?
  ownerId      String?
  /// #RRGGBB for the board and lists.
  color        String    @default("#4F46E5")
  startDate    DateTime? @db.Date
  dueDate      DateTime? @db.Date
  createdById  String?
  tasks        Task[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([departmentId])
}

/// A piece of work for someone, with a due date; on its own or in a project.
model Task {
  id           String        @id @default(uuid())
  /// TSK-YYYY-NNNNNN
  number       String        @unique
  title        String
  description  String?       @db.Text
  projectId    String?
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// todo | in_progress | review | done | cancelled
  status       String        @default("todo")
  /// low | normal | high | urgent
  priority     String        @default("normal")
  assigneeId   String?
  departmentId String?
  startDate    DateTime?     @db.Date
  dueDate      DateTime?     @db.Date
  /// Order within its status column on the board.
  sortOrder    Int           @default(0)
  /// Optional link to the record the work is about (order, deal, request, shipment…).
  linkType     String?
  linkId       String?
  createdById  String?
  completedAt  DateTime?
  /// When the "due soon" reminder went out, so it goes once.
  remindedAt   DateTime?
  comments     TaskComment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([assigneeId, status])
  @@index([projectId, status])
  @@index([departmentId, status])
  @@index([status, dueDate])
  @@index([linkType, linkId])
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String?
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}

/// How fast the service desk answers: resolution time by priority.
model ServiceSettings {
  id             String   @id @default("default")
  slaUrgentHours Int      @default(4)
  slaHighHours   Int      @default(24)
  slaNormalHours Int      @default(72)
  updatedAt      DateTime @updatedAt
}

/// A saved answer staff can drop into a reply, in each content language.
model CannedReply {
  id        String   @id @default(uuid())
  title     String
  bodyEn    String   @db.Text
  bodyAr    String   @db.Text
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A marketing push with a budget, dates and results (orders and requests that carry its utm_campaign or coupon).
model Campaign {
  id          String      @id @default(uuid())
  /// MKT-YYYY-NNNNNN
  code        String      @unique
  name        String
  /// email | social | ads | whatsapp | event | print | other
  channel     String      @default("social")
  /// planned | running | done | cancelled
  status      String      @default("planned")
  startDate   DateTime?   @db.Date
  endDate     DateTime?   @db.Date
  budget      Decimal     @default(0) @db.Decimal(15, 6)
  spend       Decimal     @default(0) @db.Decimal(15, 6)
  /// The utm_campaign value its links carry.
  utmCampaign String      @unique
  couponCode  String?
  notes       String?     @db.Text
  ownerId     String?
  createdById String?
  broadcasts  Broadcast[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status])
}

/// A group of store customers chosen by rules (orders, spend, recency, city), for broadcasts.
model CustomerSegment {
  id         String      @id @default(uuid())
  name       String
  /// { minOrders?, minSpent?, orderedWithinDays?, notOrderedForDays?, city? }
  rules      Json        @default("{}")
  broadcasts Broadcast[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

/// An e-mail to the customers of a segment who agreed to hear from the store.
model Broadcast {
  id          String               @id @default(uuid())
  name        String
  segmentId   String?
  segment     CustomerSegment?     @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  campaignId  String?
  campaign    Campaign?            @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  subjectEn   String
  subjectAr   String
  bodyEn      String               @db.Text
  bodyAr      String               @db.Text
  /// draft | sending | sent
  status      String               @default("draft")
  createdById String?
  queuedAt    DateTime?
  sentAt      DateTime?
  recipients  BroadcastRecipient[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model BroadcastRecipient {
  id          String    @id @default(uuid())
  broadcastId String
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  customerId  String
  email       String
  locale      String
  /// pending | sent | failed
  status      String    @default("pending")
  error       String?
  sentAt      DateTime?

  @@unique([broadcastId, customerId])
  @@index([broadcastId, status])
}

/// A journalist or outlet the company talks to.
model MediaContact {
  id        String   @id @default(uuid())
  name      String
  outlet    String
  role      String?
  beat      String?
  email     String?
  phone     String?
  notes     String?  @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Something the media published about the company.
model MediaCoverage {
  id          String   @id @default(uuid())
  title       String
  outlet      String
  url         String?
  publishedOn DateTime @db.Date
  /// Estimated audience.
  reach       Int?
  /// positive | neutral | negative
  sentiment   String   @default("neutral")
  /// The press release (article) it came from, if any.
  articleId   String?
  notes       String?  @db.Text
  createdById String?
  createdAt   DateTime @default(now())

  @@index([publishedOn])
}

/// A legal case or matter: a dispute, claim, regulatory issue…, with its next date and outcome.
model LegalMatter {
  id            String             @id @default(uuid())
  /// LGL-YYYY-NNNNNN
  number        String             @unique
  title         String
  /// dispute | claim | regulatory | employment | intellectual_property | other
  kind          String             @default("dispute")
  /// open | in_progress | on_hold | closed
  status        String             @default("open")
  counterparty  String?
  /// Court, authority or case reference.
  reference     String?
  /// The next hearing or deadline.
  nextDate      DateTime?          @db.Date
  assigneeId    String?
  amountAtStake Decimal?           @db.Decimal(17, 6)
  description   String?            @db.Text
  outcome       String?            @db.Text
  createdById   String?
  closedAt      DateTime?
  /// When the "next date" reminder went out, so it goes once per date.
  remindedFor   DateTime?          @db.Date
  events        LegalMatterEvent[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([status, nextDate])
}

model LegalMatterEvent {
  id       String      @id @default(uuid())
  matterId String
  matter   LegalMatter @relation(fields: [matterId], references: [id], onDelete: Cascade)
  /// note | status | date
  kind     String
  body     String      @db.Text
  byId     String?
  at       DateTime    @default(now())

  @@index([matterId, at])
}

/// A report e-mailed on a schedule, as its owner would see it.
model ReportSchedule {
  id         String    @id @default(uuid())
  reportKey  String
  /// daily | weekly | monthly
  frequency  String
  /// csv | xlsx | pdf
  format     String    @default("xlsx")
  recipients String[]
  /// en | ar
  locale     String    @default("ar")
  compare    Boolean   @default(false)
  ownerId    String
  isActive   Boolean   @default(true)
  nextRunAt  DateTime
  lastSentAt DateTime?
  lastError  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([isActive, nextRunAt])
}

/// A person's own dashboard: the widgets they chose, in order, with their sizes. Without a row the role's
/// default layout is shown.
model DashboardLayout {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// [{ id, size }] from the widget catalogue (constants/dashboard.ts), normalised on every read and write.
  widgets   Json
  updatedAt DateTime @updatedAt
}

/// A business location, distinct from its warehouses and registers.
model Branch {
  id                String   @id @default(uuid())
  code              String   @unique
  name              String
  timeZone          String
  businessDayStart  Int      @default(0)
  isActive          Boolean  @default(true)
  revision          Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  warehouses        Warehouse[]
  grants            BranchGrant[]
  registers         RetailRegister[]
  shifts            RetailShift[]
  closings          RetailClosing[]
  paymentMethods    PaymentMethodConfig[]
  collections       PaymentCollection[]
  regions           StoreRegion[]
}

/// Scope is additional to resource permissions, never a replacement for them.
model BranchGrant {
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  id        String @id @default(uuid())
  branchId  String
  branch    Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  userId    String
  canManage Boolean @default(false)
  @@unique([branchId, userId])
  @@index([userId])
}

/// Conversion snapshots on documents preserve old packaging definitions.
model ProductPackagingUnit {
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  id          String   @id @default(uuid())
  productId   String
  code        String
  name        String
  baseUnits   Decimal  @db.Decimal(17, 6)
  indivisible Boolean  @default(true)
  barcode     String?  @unique
  revision    Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  @@unique([productId, code, revision])
}

/// Identity is not another stock balance. Every active unit belongs to existing stock.
model StockSerial {
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  location StockLocation? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  id                 String   @id @default(uuid())
  code               String   @unique
  productId          String
  variantKey         String   @default("")
  batchKey           String   @default("")
  locationId         String?
  manufacturerSerial String?
  manufacturerScope  String?
  status             String   @default("reserved")
  packageId          String?
  package            StockPackage? @relation(fields: [packageId], references: [id], onDelete: Restrict)
  generationId       String
  generation         SerialGeneration @relation(fields: [generationId], references: [id], onDelete: Restrict)
  revision           Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  @@unique([manufacturerScope, manufacturerSerial])
  @@index([productId, variantKey, locationId, batchKey, status])
}

model SerialGeneration {
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  location StockLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  id             String   @id @default(uuid())
  idempotencyKey String   @unique
  requestHash    String
  productId      String
  variantKey     String   @default("")
  batchKey       String   @default("")
  locationId     String
  quantity       Int
  createdById    String
  createdAt      DateTime @default(now())
  serials        StockSerial[]
}

model StockPackage {
  location StockLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  id           String   @id @default(uuid())
  code         String   @unique
  kind         String   @default("carton")
  locationId   String
  parentId     String?
  parent       StockPackage? @relation("PackageTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     StockPackage[] @relation("PackageTree")
  status       String   @default("open")
  sealNumber   String?
  revision     Int      @default(1)
  createdById  String
  createdAt    DateTime @default(now())
  serials      StockSerial[]
  contents     PackageContent[]
}

/// Nonserialized contents only; serialized membership is StockSerial.packageId.
model PackageContent {
  id          String @id @default(uuid())
  packageId   String
  package     StockPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  productId   String
  variantKey  String @default("")
  batchKey    String @default("")
  quantity    Decimal @db.Decimal(17, 6)
  @@unique([packageId, productId, variantKey, batchKey])
}

model StockTraceEvent {
  id          String   @id @default(uuid())
  entityType  String
  entityId    String
  revision    Int
  action      String
  actorId     String
  details     Json
  createdAt   DateTime @default(now())
  @@index([entityType, entityId, createdAt])
}

model LabelPrintJob {
  id             String   @id @default(uuid())
  idempotencyKey String   @unique
  requestHash    String
  template       Json
  labels         Json
  status         String   @default("generated")
  originalJobId  String?
  createdById    String
  confirmedById  String?
  confirmedAt    DateTime?
  createdAt      DateTime @default(now())
}

model AccountingAccount {
  id       String @id @default(uuid())
  code     String @unique
  name     String
  kind     String
  isActive Boolean @default(true)
  lines    JournalLine[]
}

model AccountingPeriod {
  id        String @id @default(uuid())
  name      String @unique
  startsOn  DateTime @db.Date
  endsOn    DateTime @db.Date
  status    String @default("open")
  closedById String?
  closedAt  DateTime?
  entries   JournalEntry[]
}

/// Posted records are append-only; corrections are linked reversing entries.
model JournalEntry {
  id             String @id @default(uuid())
  sourceKey      String @unique
  requestHash    String
  periodId       String
  period         AccountingPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  postingDate    DateTime @db.Date
  currency       String
  memo           String
  branchId       String?
  reversalOfId   String? @unique
  reversalOf     JournalEntry? @relation("JournalReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal       JournalEntry? @relation("JournalReversal")
  createdById    String
  createdAt      DateTime @default(now())
  lines          JournalLine[]
  @@index([periodId, postingDate])
  @@index([branchId, postingDate])
}

model JournalLine {
  id        String @id @default(uuid())
  entryId   String
  entry     JournalEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)
  accountId String
  account   AccountingAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  debit     Decimal @db.Decimal(20, 6)
  credit    Decimal @db.Decimal(20, 6)
  memo      String?
  @@index([accountId, entryId])
}

model StockAllocation {
  id               String @id @default(uuid())
  number           String @unique
  kind             String
  sourceLocationId String
  sourceLocation   StockLocation @relation("AllocationSource", fields: [sourceLocationId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "StockAllocation_source_fk")
  transitLocationId String
  transitLocation  StockLocation @relation("AllocationTransit", fields: [transitLocationId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "StockAllocation_transit_fk")
  destinationLocationId String
  destinationLocation StockLocation @relation("AllocationDestination", fields: [destinationLocationId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "StockAllocation_destination_fk")
  status           String @default("requested")
  revision         Int @default(1)
  createdById      String
  approvedById     String?
  carrierId        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  lines            StockAllocationLine[]
  acknowledgments  StockAcknowledgment[]
}

model StockAllocationLine {
  id           String @id @default(uuid())
  allocationId String
  allocation   StockAllocation @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  productId    String
  variantKey   String @default("")
  batchKey     String @default("")
  requested    Decimal @db.Decimal(17, 6)
  dispatched   Decimal @default(0) @db.Decimal(17, 6)
  received     Decimal @default(0) @db.Decimal(17, 6)
  rejected     Decimal @default(0) @db.Decimal(17, 6)
  unitSnapshot Json
  serialIds    String[]
  @@unique([allocationId, productId, variantKey, batchKey])
}

/// A live acknowledgment references an immutable snapshot, not mutable screen data.
model StockAcknowledgment {
  id           String @id @default(uuid())
  allocationId String
  allocation   StockAllocation @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  revision     Int
  stage        String
  actorId      String
  signerName   String
  statement    String
  manifest     Json
  manifestHash String
  signature    String
  createdAt    DateTime @default(now())
  @@unique([allocationId, revision, stage, actorId])
}

model RetailRegister {
  id        String           @id @default(uuid())
  branchId  String
  branch    Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  code      String
  name      String
  isActive  Boolean          @default(true)
  revision  Int              @default(1)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  drawers   CashDrawer[]
  sessions  CashierSession[]

  @@unique([branchId, code])
  @@index([branchId])
}

model CashDrawer {
  id             String           @id @default(uuid())
  registerId     String
  register       RetailRegister   @relation(fields: [registerId], references: [id], onDelete: Restrict)
  code           String
  name           String
  currency       String           @default("BHD")
  openingFloat   Decimal          @default(0) @db.Decimal(20, 6)
  currentBalance Decimal          @default(0) @db.Decimal(20, 6)
  isActive       Boolean          @default(true)
  revision       Int              @default(1)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  sessions       CashierSession[]

  @@unique([registerId, code])
  @@index([registerId])
}

model CashierSession {
  id             String              @id @default(uuid())
  registerId     String
  register       RetailRegister      @relation(fields: [registerId], references: [id], onDelete: Restrict)
  drawerId       String
  drawer         CashDrawer          @relation(fields: [drawerId], references: [id], onDelete: Restrict)
  cashierId      String
  cashier        User                @relation("UserCashierSessions", fields: [cashierId], references: [id], onDelete: Restrict)
  shiftId        String?
  shift          RetailShift?        @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  openedAt       DateTime            @default(now())
  closedAt       DateTime?
  openingFloat   Decimal             @db.Decimal(20, 6)
  closingFloat   Decimal?            @db.Decimal(20, 6)
  expectedCash   Decimal             @default(0) @db.Decimal(20, 6)
  actualCash     Decimal             @default(0) @db.Decimal(20, 6)
  cashDifference Decimal             @default(0) @db.Decimal(20, 6)
  totalSales     Decimal             @default(0) @db.Decimal(20, 6)
  totalReturns   Decimal             @default(0) @db.Decimal(20, 6)
  status         String              @default("open")
  note           String?
  revision       Int                 @default(1)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  collections    PaymentCollection[]

  @@index([registerId, status])
  @@index([cashierId, status])
}

model RetailShift {
  id          String           @id @default(uuid())
  branchId    String
  branch      Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  shiftNumber String           @unique
  openedById  String
  openedBy    User             @relation("UserOpenedShifts", fields: [openedById], references: [id], onDelete: Restrict)
  closedById  String?
  closedBy    User?            @relation("UserClosedShifts", fields: [closedById], references: [id], onDelete: Restrict)
  openedAt    DateTime         @default(now())
  closedAt    DateTime?
  status      String           @default("open")
  revision    Int              @default(1)
  sessions    CashierSession[]

  @@index([branchId, status])
}

model RetailClosing {
  id           String   @id @default(uuid())
  branchId     String
  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  level        String
  targetId     String
  businessDate DateTime @db.Date
  closedAt     DateTime @default(now())
  closedById   String
  closedBy     User     @relation("UserRetailClosings", fields: [closedById], references: [id], onDelete: Restrict)
  totalSales   Decimal  @db.Decimal(20, 6)
  totalReturns Decimal  @db.Decimal(20, 6)
  totalCash    Decimal  @db.Decimal(20, 6)
  totalCard    Decimal  @db.Decimal(20, 6)
  totalOther   Decimal  @db.Decimal(20, 6)
  cashVariance Decimal  @db.Decimal(20, 6)
  snapshot     Json
  signature    String?
  journalId    String?
  status       String   @default("closed")
  revision     Int      @default(1)

  @@index([branchId, level, businessDate])
  @@index([targetId, level])
}

model PaymentMethodConfig {
  id                String   @id @default(uuid())
  branchId          String
  branch            Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  code              String
  nameEn            String
  nameAr            String
  isEnabled         Boolean  @default(true)
  allowChange       Boolean  @default(false)
  requiresReference Boolean  @default(false)
  surchargeRate     Decimal  @default(0) @db.Decimal(5, 4)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([branchId, code])
  @@index([branchId])
}

model PaymentCollection {
  id              String          @id @default(uuid())
  number          String          @unique
  branchId        String
  branch          Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sessionId       String?
  session         CashierSession? @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  orderId         String?
  invoiceId       String?
  amount          Decimal         @db.Decimal(20, 6)
  currency        String
  methodCode      String
  referenceNumber String?
  evidence        Json?
  status          String          @default("collected")
  collectedById   String
  collectedBy     User            @relation("UserPaymentCollections", fields: [collectedById], references: [id], onDelete: Restrict)
  collectedAt     DateTime        @default(now())

  @@index([branchId, methodCode, status])
  @@index([sessionId])
}

model CommissionRule {
  id            String               @id @default(uuid())
  code          String               @unique
  name          String
  rate          Decimal              @db.Decimal(5, 4)
  effectiveFrom DateTime             @db.Date
  effectiveTo   DateTime?            @db.Date
  version       Int                  @default(1)
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  snapshots     CommissionSnapshot[]
}

model CommissionSnapshot {
  id                 String              @id @default(uuid())
  orderId            String
  orderLineId        String?
  attributedUserId   String
  attributedUser     User                @relation("UserAttributedCommissions", fields: [attributedUserId], references: [id], onDelete: Restrict)
  ruleId             String
  rule               CommissionRule      @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  ruleVersion        Int
  ruleRate           Decimal             @db.Decimal(5, 4)
  basisAmount        Decimal             @db.Decimal(20, 6)
  commissionAmount   Decimal             @db.Decimal(20, 6)
  currency           String
  status             String              @default("earned")
  reversalOfId       String?             @unique
  reversalOf         CommissionSnapshot? @relation("CommissionReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal           CommissionSnapshot? @relation("CommissionReversal")
  calculationDetails Json
  earnedAt           DateTime            @default(now())
  createdById        String

  @@index([attributedUserId, status, earnedAt])
  @@index([orderId])
}

model StoreRegion {
  id              String   @id @default(uuid())
  code            String   @unique
  nameEn          String
  nameAr          String
  currency        String
  defaultLanguage String   @default("en")
  branchId        String
  branch          Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  isEnabled       Boolean  @default(true)
  priceMultiplier Decimal  @default(1.0000) @db.Decimal(10, 4)
  settings        Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([branchId])
}

// Receipts reject reordered and retried transitional identity profile deliveries.
model IdentityProjectionReceipt {
 id String @id
 version BigInt
}
