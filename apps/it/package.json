{
  "name": "@platform/it",
  "version": "1.0.0",
  "private": true,
  "allowScripts": {
    "fsevents": true
  },
  "description": "The IT department's dashboard: IT accounts (their own realm, MFA required), the ticket desk and system settings.",
  "scripts": {
    "dev": "next dev --turbopack -p 3002",
    "build": "next build --webpack",
    "start": "next start -p 3002",
    "lint": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:support": "node scripts/check-support.cjs",
    "check:security": "node scripts/check-audit-security.cjs",
    "check:deployment": "node scripts/check-deployment-config.cjs"
  },
  "dependencies": {
    "@floating-ui/react-dom": "^2.1.9",
    "@material/material-color-utilities": "^0.4.0",
    "@material/web": "^2.5.0",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.9",
    "jose": "^6.2.12",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^0.475.0",
    "next": "16.4.4",
    "openapi-fetch": "^0.17.0",
    "overlayscrollbars": "^2.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.8",
    "svix": "^2.9.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^4.1.12"
  }
}
