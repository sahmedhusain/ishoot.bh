{
  "compilerOptions": {
    "target": "es5",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "forceConsistentCasingInFileNames": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@platform/api-client": [
        "./lib/api/index.ts"
      ],
      "@platform/api-client/*": [
        "./lib/api/*"
      ],
      "@platform/config/currency": [
        "./lib/config/currency.ts"
      ],
      "@platform/config/currency/*": [
        "./lib/config/currency/*"
      ],
      "@platform/config": [
        "./lib/config/index.ts"
      ],
      "@platform/config/*": [
        "./lib/config/*"
      ],
      "@platform/contracts": [
        "./lib/contracts/src/index.ts"
      ],
      "@platform/contracts/catalog/*": [
        "./lib/contracts/catalog/*"
      ],
      "@platform/contracts/*": [
        "./lib/contracts/src/*"
      ],
      "@platform/email": [
        "./lib/email/index.ts"
      ],
      "@platform/email/*": [
        "./lib/email/*"
      ],
      "@platform/locales": [
        "./locales/index.ts"
      ],
      "@platform/locales/*": [
        "./locales/*"
      ],
      "@platform/ui": [
        "./components/ui/index.ts"
      ],
      "@platform/ui/*": [
        "./components/ui/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "tests"
  ]
}
